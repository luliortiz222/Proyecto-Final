@model IEnumerable<ProyectoIntegradorFinal.Models.Marca>

@{
    ViewData["Title"] = "Gestión de Marcas";
}

<div class="container mt-4">
    <h2>Marcas Registradas</h2>
    <hr />

    <p>
        <a asp-action="Create" class="btn btn-primary">Agregar Nueva Marca</a>
    </p>

    <div class="col-md-6">
        <table class="table table-striped table-hover mt-3">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre de la Marca</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdMarca</td>
                        <td class="fw-bold">@item.Nombre</td>
                        <td>
                            <!-- Botón para futura funcionalidad -->
                            <a asp-action="Edit" asp-route-id="@item.IdMarca" class="btn btn-sm btn-outline-secondary">Editar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>