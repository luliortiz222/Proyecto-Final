@using System.Linq
@model IEnumerable<ProyectoIntegradorFinal.Models.Marca>

@{
    ViewData["Title"] = "Gestión de Marcas";

    string buscar = ViewBag.Buscar as string ?? "";
    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 0;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;
}

<div class="container mt-4 mb-5 he-marcas">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="he-etiqueta">HOME ELIXIR</span>
            <h2 class="he-titulo mt-2">Marcas registradas</h2>
            <p class="text-muted mb-0">
                Administrá las marcas de nuestra perfumería.
            </p>
        </div>

        <a asp-action="Create" class="btn he-btn-dorado">
            <i class="fas fa-plus me-2"></i>
            Nueva marca
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Mensaje"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    <!-- BUSCADOR AUTOMÁTICO -->
    <form id="formBuscarMarcas"
          asp-controller="Marcas"
          asp-action="Index"
          method="get"
          class="he-buscador mb-4">

        <div class="input-group">
            <span class="input-group-text he-icono-busqueda">
                <i class="fas fa-search"></i>
            </span>

            <input type="search"
                   id="buscarMarcas"
                   name="buscar"
                   value="@buscar"
                   class="form-control"
                   placeholder="Buscar marca..."
                   aria-label="Buscar marca"
                   autocomplete="off" />

            <a asp-action="Index"
               id="limpiarBusquedaMarcas"
               class="btn he-btn-limpiar"
               style="display: @(string.IsNullOrWhiteSpace(buscar) ? "none" : "inline-block")">
                <i class="fas fa-times me-1"></i>
                Limpiar
            </a>
        </div>

        <small id="estadoBusquedaMarcas"
               class="text-muted d-block mt-2"
               aria-live="polite">
            Escribí una letra o el nombre de una marca para buscar.
        </small>
    </form>

    <!-- TABLA DE MARCAS -->
    <div class="he-tabla-contenedor">
        <div class="table-responsive">
            <table class="table he-tabla align-middle mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre de la marca</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody id="tablaMarcas">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var marca in Model)
                        {
                            <tr>
                                <td>@marca.IdMarca</td>

                                <td class="fw-semibold">
                                    @marca.Nombre
                                </td>

                                <td class="text-end">
                                    <a asp-action="Edit"
                                       asp-route-id="@marca.IdMarca"
                                       class="btn btn-sm he-btn-editar">
                                        <i class="fas fa-pen me-1"></i>
                                        Editar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5">
                                <i class="fas fa-tags he-icono-vacio"></i>

                                <p class="mt-3 mb-1 fw-semibold">
                                    No se encontraron marcas.
                                </p>

                                <span class="text-muted">
                                    Probá con otra letra o palabra.
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- RESULTADOS Y PAGINACIÓN -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mt-3">

        <small class="text-muted" id="contadorMarcas">
            Resultados: @totalRegistros
        </small>

        <nav id="contenedorPaginacion"
             aria-label="Paginación de marcas">

            @if (totalPaginas > 1)
            {
                <ul class="pagination he-paginacion mb-0">

                    <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-buscar="@buscar"
                           asp-route-pagina="@(paginaActual - 1)">
                            Anterior
                        </a>
                    </li>

                    @for (int i = 1; i <= totalPaginas; i++)
                    {
                        <li class="page-item @(i == paginaActual ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-buscar="@buscar"
                               asp-route-pagina="@i">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-buscar="@buscar"
                           asp-route-pagina="@(paginaActual + 1)">
                            Siguiente
                        </a>
                    </li>

                </ul>
            }
        </nav>
    </div>

    <!-- VOLVER A PRODUCTOS -->
    <div class="d-flex justify-content-start mt-4">
        <a asp-controller="Productos"
           asp-action="Index"
           class="btn he-btn-volver">
            <i class="fas fa-arrow-left me-2"></i>
            Volver a Productos
        </a>
    </div>

</div>


<!-- SECCIÓN VUE: GESTIÓN REACTIVA DE MARCAS -->
<div id="pruebaVueMarcas" class="mt-5">

    <hr class="my-4" />

    <h3>{{ mensaje }}</h3>
    <p class="text-muted">
        Gestión de marcas mediante Vue.
    </p>

    <div class="card card-body mb-4">
        <h5>
            {{ idMarcaEditando === null ? 'Nueva marca' : 'Editar marca' }}
        </h5>

        <form v-on:submit.prevent="guardarMarca">
            <label for="nombreMarcaVue" class="form-label">
                Nombre de la marca
            </label>

            <input id="nombreMarcaVue"
                   v-model="nombreFormulario"
                   class="form-control mb-3"
                   maxlength="100"
                   required
                   placeholder="Ej.: Bulgari" />

            <div class="d-flex gap-2">
                <button type="submit"
                        class="btn btn-dark"
                        :disabled="guardando">
                    {{ guardando ? 'Guardando...' : (idMarcaEditando === null ? 'Crear marca' : 'Guardar cambios') }}
                </button>

                <button v-if="idMarcaEditando !== null"
                        type="button"
                        class="btn btn-outline-secondary"
                        v-on:click="cancelarEdicion">
                    Cancelar
                </button>
            </div>
        </form>
    </div>

    <div v-if="error" class="alert alert-danger">
        {{ error }}
    </div>

    <div v-if="mensajeOperacion" class="alert alert-success">
        {{ mensajeOperacion }}
    </div>

    <p v-if="cargando">Cargando marcas...</p>

    <div v-if="!cargando" class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                <tr v-for="marca in marcas" :key="marca.idMarca">
                    <td>{{ marca.idMarca }}</td>
                    <td>{{ marca.nombre }}</td>
                    <td class="text-end">
                        <button type="button"
                                class="btn btn-sm btn-outline-primary me-1"
                                v-on:click="iniciarEdicion(marca)">
                            Editar
                        </button>

                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                v-on:click="eliminarMarca(marca)">
                            Eliminar
                        </button>
                    </td>
                </tr>

                <tr v-if="marcas.length === 0">
                    <td colspan="3" class="text-center">
                        No hay marcas registradas.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

</div>

@section Scripts {
    <!-- Búsqueda automática de marcas en el servidor -->
    <script>
        (() => {
            const formulario = document.getElementById('formBuscarMarcas');
            const buscador = document.getElementById('buscarMarcas');
            const limpiar = document.getElementById('limpiarBusquedaMarcas');
            const estado = document.getElementById('estadoBusquedaMarcas');
            const tabla = document.getElementById('tablaMarcas');
            const contador = document.getElementById('contadorMarcas');
            const paginacion = document.getElementById('contenedorPaginacion');

            if (!formulario || !buscador || !limpiar ||
                !estado || !tabla || !contador || !paginacion) {
                return;
            }

            let temporizador;
            let controladorActual = null;

            buscador.addEventListener('input', () => {
                clearTimeout(temporizador);

                limpiar.style.display = buscador.value.trim()
                    ? 'inline-block'
                    : 'none';

                estado.textContent = 'Buscando marcas...';

                temporizador = setTimeout(async () => {
                    if (controladorActual) {
                        controladorActual.abort();
                    }

                    const controlador = new AbortController();
                    controladorActual = controlador;

                    const parametros = new URLSearchParams(
                        new FormData(formulario)
                    );

                    // Cada nueva búsqueda comienza en la página 1.
                    parametros.delete('pagina');

                    const url = formulario.action + '?' + parametros.toString();

                    try {
                        const respuesta = await fetch(url, {
                            method: 'GET',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            signal: controlador.signal
                        });

                        if (!respuesta.ok) {
                            throw new Error('No se pudieron cargar las marcas.');
                        }

                        const html = await respuesta.text();

                        const documento = new DOMParser().parseFromString(
                            html,
                            'text/html'
                        );

                        const nuevaTabla =
                            documento.getElementById('tablaMarcas');
                        const nuevoContador =
                            documento.getElementById('contadorMarcas');
                        const nuevaPaginacion =
                            documento.getElementById('contenedorPaginacion');

                        if (!nuevaTabla || !nuevoContador || !nuevaPaginacion) {
                            throw new Error(
                                'La respuesta no contiene los resultados esperados.'
                            );
                        }

                        // Ignorar respuestas de búsquedas anteriores.
                        if (controlador !== controladorActual) {
                            return;
                        }

                        tabla.innerHTML = nuevaTabla.innerHTML;
                        contador.innerHTML = nuevoContador.innerHTML;
                        paginacion.innerHTML = nuevaPaginacion.innerHTML;

                        estado.textContent = 'Resultados actualizados.';
                    }
                    catch (error) {
                        if (error.name !== 'AbortError') {
                            console.error(error);
                            estado.textContent =
                                'No se pudo completar la búsqueda. Intentá nuevamente.';
                        }
                    }
                }, 200);
            });

            // Limpiar búsqueda sin recargar la página.
            limpiar.addEventListener('click', event => {
                    event.preventDefault();
                        buscador.value = '';
                        clearTimeout(temporizador);

                        if (controladorActual) {
                            controladorActual.abort();
                        }

                        buscador.dispatchEvent(new Event('input'));
                    });

                    // Evitar que el formulario recargue la página.
                    formulario.addEventListener('submit', event => {
                        event.preventDefault();
                        clearTimeout(temporizador);
                        buscador.dispatchEvent(new Event('input'));
                    });
                })();
    </script>

    <!-- Vue 3 -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>

    <script>
        if (typeof Vue !== 'undefined') {
            Vue.createApp({
                data() {
                    return {
                        mensaje: 'Gestión de marcas con Vue',
                        marcas: [],
                        cargando: true,
                        guardando: false,
                        error: '',
                        mensajeOperacion: '',
                        idMarcaEditando: null,
                        nombreFormulario: ''
                    };
                },

                async mounted() {
                    await this.cargarMarcas();
                },

                methods: {
                    async cargarMarcas() {
                        this.cargando = true;
                        this.error = '';

                        try {
                            const respuesta = await fetch('/api/marca');

                            if (!respuesta.ok) {
                                throw new Error(
                                    'No se pudieron cargar las marcas de la API.'
                                );
                            }

                            this.marcas = await respuesta.json();
                        } catch (error) {
                            this.error = error.message;
                        } finally {
                            this.cargando = false;
                        }
                    },

                    iniciarEdicion(marca) {
                        this.idMarcaEditando = marca.idMarca;
                        this.nombreFormulario = marca.nombre;
                        this.error = '';
                        this.mensajeOperacion = '';
                    },

                    cancelarEdicion() {
                        this.idMarcaEditando = null;
                        this.nombreFormulario = '';
                        this.error = '';
                    },

                    async guardarMarca() {
                        const nombre = this.nombreFormulario.trim();

                        if (!nombre) {
                            this.error = 'Ingresá el nombre de la marca.';
                            return;
                        }

                        this.guardando = true;
                        this.error = '';
                        this.mensajeOperacion = '';

                        const editando = this.idMarcaEditando !== null;

                        const url = editando
                            ? `/api/marca/${this.idMarcaEditando}`
                            : '/api/marca';

                        const metodo = editando ? 'PUT' : 'POST';

                        const datos = editando
                            ? {
                                idMarca: this.idMarcaEditando,
                                nombre: nombre
                            }
                            : { nombre: nombre };

                        try {
                            const respuesta = await fetch(url, {
                                method: metodo,
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify(datos)
                            });

                            if (!respuesta.ok) {
                                let detalle = 'No se pudo guardar la marca.';

                                try {
                                    const cuerpo = await respuesta.json();
                                    if (cuerpo.mensaje) {
                                        detalle = cuerpo.mensaje;
                                    }
                                } catch (_) { }

                                throw new Error(detalle);
                            }

                            this.idMarcaEditando = null;
                            this.nombreFormulario = '';

                            await this.cargarMarcas();

                            this.mensajeOperacion = editando
                                ? 'Marca actualizada correctamente.'
                                : 'Marca creada correctamente.';
                        } catch (error) {
                            this.error = error.message;
                        } finally {
                            this.guardando = false;
                        }
                    },

                    async eliminarMarca(marca) {
                        const confirmar = confirm(
                            `¿Querés eliminar la marca "${marca.nombre}"?`
                        );

                        if (!confirmar) return;

                        this.error = '';
                        this.mensajeOperacion = '';

                        try {
                            const respuesta = await fetch(
                                `/api/marca/${marca.idMarca}`,
                                { method: 'DELETE' }
                            );

                            if (!respuesta.ok) {
                                let detalle = 'No se pudo eliminar la marca.';

                                try {
                                    const cuerpo = await respuesta.json();
                                    if (cuerpo.mensaje) {
                                        detalle = cuerpo.mensaje;
                                    }
                                } catch (_) { }

                                throw new Error(detalle);
                            }

                            if (this.idMarcaEditando === marca.idMarca) {
                                this.cancelarEdicion();
                            }

                            await this.cargarMarcas();

                            this.mensajeOperacion =
                                'Marca eliminada correctamente.';
                        } catch (error) {
                            this.error = error.message;
                        }
                    }
                }
            }).mount('#pruebaVueMarcas');
        } else {
            const contenedor =
                document.getElementById('pruebaVueMarcas');

            if (contenedor) {
                contenedor.textContent =
                    'No se pudo cargar Vue. Verificá tu conexión a Internet.';
            }
        }
    </script>
}


