@model ProyectoIntegradorFinal.Models.Marca

@{
    ViewData["Title"] = "Editar marca";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h2 class="mb-4">Editar marca</h2>

                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="IdMarca" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Nombre"
                                   class="form-label">
                                Nombre de la marca
                            </label>

                            <input asp-for="Nombre"
                                   class="form-control"
                                   maxlength="100"
                                   required />

                            <span asp-validation-for="Nombre"
                                  class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-dark">
                                Guardar cambios
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

