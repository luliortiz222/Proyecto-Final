@model IEnumerable<ProyectoIntegradorFinal.Models.Producto>

@{
    ViewData["Title"] = "Catálogo de Perfumes";
    bool esAdministrador = User.IsInRole("Administrador");
    bool esCliente = User.IsInRole("Cliente");
    int paginaActual = ViewBag.PaginaActual;
    int totalPaginas = ViewBag.TotalPaginas;
}

<div class="container mt-4 mb-5 he-productos">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
        <div>
            <span class="text-uppercase small"
                  style="letter-spacing: .15em; color: #96713D;">
                HOME ELIXIR
            </span>
            <h2 class="mt-2">Catálogo de perfumes</h2>
            <p class="text-muted mb-0">
                Explorá las fragancias y encontrá tu próxima esencia.
            </p>
        </div>

        @if (esAdministrador)
        {
            <a asp-action="Create" class="btn btn-dark">
                <i class="fas fa-plus me-2"></i>
                Agregar perfume
            </a>
        }
    </div>

    <hr class="mb-4" />

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Mensaje"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- BÚSQUEDA Y FILTROS DEL CATÁLOGO MVC -->
    <form id="buscarForm"
          asp-controller="Productos"
          asp-action="Index"
          method="get"
          class="p-3 p-md-4 mb-4"
          style="background: #F7F1E8; border: 1px solid #E5D8C5;">

        <div class="row g-3 align-items-end">

            <div class="col-12 col-md-4">
                <label for="buscar" class="form-label">
                    Buscar perfume o marca
                </label>

                <div class="position-relative">
                    <input type="text"
                           id="buscar"
                           name="buscar"
                           value="@ViewBag.Buscar"
                           class="form-control"
                           placeholder="Ej.: Oud Wood, Dior..."
                           autocomplete="off"
                           aria-autocomplete="list"
                           aria-controls="sugerenciasBusqueda" />

                    <div id="sugerenciasBusqueda"
                         class="list-group position-absolute w-100 shadow"
                         style="display:none;z-index:1050;max-height:320px;overflow-y:auto;">
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-3">
                <label for="idCategoria" class="form-label">Categoría</label>

                <select id="idCategoria" name="idCategoria" class="form-select">
                    <option value="">Todas las categorías</option>

                    @foreach (var categoria in
                        (IEnumerable<ProyectoIntegradorFinal.Models.Categoria>)ViewBag.Categorias)
                    {
                        if (ViewBag.IdCategoria != null &&
                            (int)ViewBag.IdCategoria == categoria.IdCategoria)
                        {
                            <option value="@categoria.IdCategoria" selected>
                                @categoria.Nombre
                            </option>
                        }
                        else
                        {
                            <option value="@categoria.IdCategoria">
                                @categoria.Nombre
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="col-12 col-md-3">
                <label for="idMarca" class="form-label">Marca</label>

                <select id="idMarca" name="idMarca" class="form-select">
                    <option value="">Todas las marcas</option>

                    @foreach (var marca in
                        (IEnumerable<ProyectoIntegradorFinal.Models.Marca>)ViewBag.Marcas)
                    {
                        if (ViewBag.IdMarca != null &&
                            (int)ViewBag.IdMarca == marca.IdMarca)
                        {
                            <option value="@marca.IdMarca" selected>
                                @marca.Nombre
                            </option>
                        }
                        else
                        {
                            <option value="@marca.IdMarca">
                                @marca.Nombre
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-dark flex-grow-1">
                    <i class="fas fa-search me-1"></i>Buscar
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary"
                   title="Limpiar filtros"
                   aria-label="Limpiar filtros">
                    <i class="fas fa-rotate-left"></i>
                </a>
            </div>

        </div>
    </form>

    <!-- RESULTADOS DEL CATÁLOGO -->
    <div id="resultadosCatalogo">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Fragancias disponibles</h5>
            <span class="text-muted small">@Model.Count() resultados</span>
        </div>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Imagen</th>
                            <th>Nombre</th>
                            <th>Marca</th>
                            <th>Descripción</th>
                            <th>Categoría</th>
                            <th>Presentación</th>
                            <th>Precio</th>

                            @if (esCliente)
                            {
                                <th>Carrito</th>
                            }

                            @if (esAdministrador)
                            {
                                <th>Stock</th>
                                <th>Acciones</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.ImagenUrl))
                                    {
                                        <img src="@item.ImagenUrl"
                                             alt="@item.Nombre"
                                             loading="lazy"
                                             style="width:60px;height:70px;object-fit:contain;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sin imagen</span>
                                    }
                                </td>

                                <td class="fw-semibold">@item.Nombre</td>
                                <td>@(item.Marca?.Nombre ?? "Sin marca")</td>

                                <td style="min-width:200px;white-space:normal;">
                                    @(string.IsNullOrWhiteSpace(item.Descripcion)
                                        ? "Sin descripción"
                                        : item.Descripcion)
                                </td>

                                <td>@(item.Categoria?.Nombre ?? "Sin categoría")</td>

                                <td>
                                    @item.VolumenMl ml
                                    <br />
                                    <small class="text-muted">@item.Concentracion</small>
                                </td>

                                <td class="fw-semibold">@item.Precio.ToString("C")</td>

                                @if (esCliente)
                                {
                                    <td>
                                        <form asp-controller="Carrito"
                                              asp-action="Agregar"
                                              method="post">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="IdProducto"
                                                   value="@item.IdProducto" />
                                            <input type="hidden"
                                                   name="cantidad"
                                                   value="1" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-dark"
                                                    disabled="@(item.Stock < 1)"
                                                    title="@(item.Stock < 1 ? "Sin stock disponible" : "Agregar al carrito")">
                                                <i class="fas fa-shopping-bag me-1"></i>
                                                @(item.Stock < 1 ? "Sin stock" : "Agregar")
                                            </button>
                                        </form>
                                    </td>
                                }

                                @if (esAdministrador)
                                {
                                    <td>@item.Stock</td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-2">
                                            <a asp-action="Edit"
                                               asp-route-id="@item.IdProducto"
                                               class="btn btn-sm btn-warning">Editar</a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.IdProducto"
                                               class="btn btn-sm btn-danger">Eliminar</a>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5"
                 style="background:#F7F1E8;border:1px solid #E5D8C5;">
                <i class="fas fa-wind fa-2x mb-3" style="color:#B08D57;"></i>
                <h4>No encontramos fragancias</h4>
                <p class="text-muted">Probá con otro nombre o cambiá los filtros.</p>
                <a asp-action="Index" class="btn btn-outline-dark">
                    Ver todo el catálogo
                </a>
            </div>
        }

        @if (totalPaginas > 1)
        {
            <nav aria-label="Paginación de productos" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pagina="@(paginaActual - 1)"
                           asp-route-buscar="@ViewBag.Buscar"
                           asp-route-idCategoria="@ViewBag.IdCategoria"
                           asp-route-idMarca="@ViewBag.IdMarca">Anterior</a>
                    </li>

                    @for (int i = 1; i <= totalPaginas; i++)
                    {
                        <li class="page-item @(i == paginaActual ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@i"
                               asp-route-buscar="@ViewBag.Buscar"
                               asp-route-idCategoria="@ViewBag.IdCategoria"
                               asp-route-idMarca="@ViewBag.IdMarca">@i</a>
                        </li>
                    }

                    <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pagina="@(paginaActual + 1)"
                           asp-route-buscar="@ViewBag.Buscar"
                           asp-route-idCategoria="@ViewBag.IdCategoria"
                           asp-route-idMarca="@ViewBag.IdMarca">Siguiente</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

@if (esAdministrador)
{
    <!-- PANEL VUE: NO CARGA TODAS LAS MARCAS Y CATEGORÍAS -->
    <div id="appProductosVue"
         class="container mb-5"
         v-cloak>

        <hr class="my-4" />

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <span class="text-uppercase small"
                      style="letter-spacing:.15em;color:#96713D;">
                    ADMINISTRACIÓN CON VUE
                </span>
                <h3 class="mt-2 mb-1">Gestión de perfumes</h3>
                <p class="text-muted mb-0">Administrá el catálogo desde este panel.</p>
            </div>

            <button type="button" class="btn btn-dark" @@click="nuevoProducto">
                <i class="fas fa-plus me-2"></i>Nuevo perfume
            </button>
        </div>

        <div v-if="mensaje"
             class="alert alert-dismissible fade show d-flex align-items-start gap-3 shadow-sm"
             :class="esError ? 'alert-danger' : 'alert-success'"
             role="alert"
             style="border-radius: 8px;">

            <i :class="esError
                ? 'fas fa-circle-exclamation fs-4 mt-1'
                : 'fas fa-circle-check fs-4 mt-1'">
            </i>

            <div class="flex-grow-1">
                <div class="fw-semibold mb-1">
                    {{ esError ? 'No se pudo completar la operación' : 'Operación exitosa' }}
                </div>

                <div>{{ mensaje }}</div>
            </div>

            <button type="button"
                    class="btn-close"
                    aria-label="Cerrar mensaje"
                @@click="mensaje = ''">
            </button>
        </div>

        <div v-if="cargando" class="text-center py-4">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="text-muted mt-2">Cargando perfumes...</p>
        </div>

        <div v-else class="table-responsive mb-4">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Marca</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    <tr v-for="producto in productos" :key="producto.idProducto">
                        <td>{{ producto.idProducto }}</td>
                        <td>{{ producto.nombre }}</td>
                        <td>{{ producto.marca?.nombre || 'Sin marca' }}</td>
                        <td>{{ producto.categoria?.nombre || 'Sin categoría' }}</td>
                        <td>{{ formatoPrecio(producto.precio) }}</td>
                        <td>{{ producto.stock }}</td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <button type="button"
                                        class="btn btn-sm btn-warning"
                                    @@click="editarProducto(producto)">
                                    Editar
                                </button>

                                <button type="button"
                                        class="btn btn-sm btn-danger"
                                    @@click="eliminarProducto(producto)">
                                    Eliminar
                                </button>
                            </div>
                        </td>
                    </tr>

                    <tr v-if="productos.length === 0">
                        <td colspan="7" class="text-center py-4 text-muted">
                            No hay perfumes para mostrar.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div v-if="mostrarFormulario"
             class="p-3 p-md-4"
             style="background:#F7F1E8;border:1px solid #E5D8C5;">

            <h4 class="mb-4">
                {{ editando ? 'Editar perfume' : 'Nuevo perfume' }}
            </h4>

            <form @@submit.prevent="guardarProducto">
                <div class="row g-3">

                    <div class="col-12 col-md-6">
                        <label for="vueNombre" class="form-label">Nombre</label>
                        <input id="vueNombre"
                               v-model.trim="form.nombre"
                               type="text"
                               class="form-control"
                               maxlength="150"
                               required />
                    </div>

                    <div class="col-12 col-md-6">
                        <label for="vuePrecio" class="form-label">Precio</label>
                        <input id="vuePrecio"
                               v-model.number="form.precio"
                               type="number"
                               class="form-control"
                               min="0.01"
                               step="0.01"
                               required />
                    </div>

                    <div class="col-12">
                        <label for="vueDescripcion" class="form-label">Descripción</label>
                        <textarea id="vueDescripcion"
                                  v-model.trim="form.descripcion"
                                  class="form-control"
                                  rows="3"></textarea>
                    </div>

                    <!-- MARCA: BÚSQUEDA AJAX -->
                    <div class="col-12 col-md-6">
                        <label for="vueMarca" class="form-label">Marca</label>

                        <div class="position-relative">
                            <input id="vueMarca"
                                   v-model="form.marcaBusqueda"
                                   type="text"
                                   class="form-control"
                                   placeholder="Escribí una marca..."
                                   autocomplete="off"
                            @@input="buscarMarcas"
                                   required />

                            <div v-if="cargandoMarcas" class="form-text">
                                Buscando marcas...
                            </div>

                            <div v-if="marcas.length > 0"
                                 class="list-group position-absolute w-100 shadow"
                                 style="z-index:1050;max-height:220px;overflow-y:auto;">
                                <button v-for="marca in marcas"
                                        :key="marca.idMarca"
                                        type="button"
                                        class="list-group-item list-group-item-action text-start"
                                    @@click="seleccionarMarca(marca)">
                                    {{ marca.nombre }}
                                </button>
                            </div>

                            <div v-if="form.marcaBusqueda && !form.idMarca && !cargandoMarcas"
                                 class="form-text">
                                Elegí una marca de las sugerencias.
                            </div>
                        </div>
                    </div>

                    <!-- CATEGORÍA: BÚSQUEDA AJAX -->
                    <div class="col-12 col-md-6">
                        <label for="vueCategoria" class="form-label">Categoría</label>

                        <div class="position-relative">
                            <input id="vueCategoria"
                                   v-model="form.categoriaBusqueda"
                                   type="text"
                                   class="form-control"
                                   placeholder="Escribí una categoría..."
                                   autocomplete="off"
                            @@input="buscarCategorias"
                                   required />

                            <div v-if="cargandoCategorias" class="form-text">
                                Buscando categorías...
                            </div>

                            <div v-if="categorias.length > 0"
                                 class="list-group position-absolute w-100 shadow"
                                 style="z-index:1050;max-height:220px;overflow-y:auto;">
                                <button v-for="categoria in categorias"
                                        :key="categoria.idCategoria"
                                        type="button"
                                        class="list-group-item list-group-item-action text-start"
                                    @@click="seleccionarCategoria(categoria)">
                                    {{ categoria.nombre }}
                                </button>
                            </div>

                            <div v-if="form.categoriaBusqueda && !form.idCategoria && !cargandoCategorias"
                                 class="form-text">
                                Elegí una categoría de las sugerencias.
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <label for="vueVolumen" class="form-label">Volumen (ml)</label>
                        <input id="vueVolumen"
                               v-model.number="form.volumenMl"
                               type="number"
                               class="form-control"
                               min="1"
                               required />
                    </div>

                    <div class="col-12 col-md-4">
                        <label for="vueConcentracion" class="form-label">Concentración</label>
                        <select id="vueConcentracion"
                                v-model="form.concentracion"
                                class="form-select"
                                required>
                            <option value="" disabled>Elegí una opción</option>
                            <option value="Eau de Parfum">Eau de Parfum</option>
                            <option value="Eau de Toilette">Eau de Toilette</option>
                            <option value="Parfum">Parfum</option>
                            <option value="Extrait">Extrait</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-4">
                        <label for="vueStock" class="form-label">Stock</label>
                        <input id="vueStock"
                               v-model.number="form.stock"
                               type="number"
                               class="form-control"
                               min="0"
                               required />
                    </div>

                    <div class="col-12">
                        <label for="vueArchivoImagen" class="form-label">
                            Imagen del perfume
                        </label>
                        <input id="vueArchivoImagen"
                               type="file"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.webp"
                        @@change="seleccionarImagen" />
                        <small class="text-muted">
                            JPG, PNG o WEBP. Máximo 2 MB. Si editás sin elegir otra imagen,
                            se conserva la actual.
                        </small>
                    </div>

                    <div class="col-12" v-if="form.vistaPrevia">
                        <p class="form-label mb-2">
                            {{ editando ? 'Imagen actual o nueva imagen' : 'Vista previa' }}
                        </p>
                        <img :src="form.vistaPrevia"
                             alt="Vista previa del perfume"
                             style="width:120px;height:145px;object-fit:contain;background:white;border:1px solid #E5D8C5;padding:6px;"
                        @@error="$event.target.style.display = 'none'" />

                        <button v-if="form.archivoImagen"
                                type="button"
                                class="btn btn-sm btn-outline-secondary d-block mt-2"
                            @@click="quitarImagenSeleccionada">
                            Quitar nueva imagen
                        </button>
                    </div>

                    <div class="col-12 d-flex flex-wrap gap-2 mt-4">
                        <button type="submit"
                                class="btn btn-dark"
                                :disabled="guardando">
                            {{ guardando ? 'Guardando...' : (editando ? 'Guardar cambios' : 'Crear perfume') }}
                        </button>

                        <button type="button"
                                class="btn btn-outline-secondary"
                            @@click="cancelarFormulario"
                                :disabled="guardando">
                            Cancelar
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <!-- BUSCADOR Y SUGERENCIAS DEL CATÁLOGO MVC -->
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const formulario = document.getElementById("buscarForm");
            const resultados = document.getElementById("resultadosCatalogo");
            const sugerencias = document.getElementById("sugerenciasBusqueda");

            if (!formulario || !resultados || !sugerencias) return;

            const campoBuscar = formulario.querySelector('[name="buscar"]');
            const campoCategoria = formulario.querySelector('[name="idCategoria"]');
            const campoMarca = formulario.querySelector('[name="idMarca"]');

            if (!campoBuscar || !campoCategoria || !campoMarca) return;

            let temporizador;
            let controladorActual;

            function ocultarSugerencias() {
                sugerencias.innerHTML = "";
                sugerencias.style.display = "none";
            }

            function mostrarSugerencias(filas) {
                sugerencias.innerHTML = "";
                const termino = campoBuscar.value.trim();

                if (!termino) {
                    ocultarSugerencias();
                    return;
                }

                if (filas.length === 0) {
                    const mensaje = document.createElement("div");
                    mensaje.className = "list-group-item text-muted small";
                    mensaje.textContent = "No se encontraron perfumes.";
                    sugerencias.appendChild(mensaje);
                    sugerencias.style.display = "block";
                    return;
                }

                filas.slice(0, 8).forEach(function(fila) {
                    const celdas = fila.querySelectorAll("td");
                    if (celdas.length < 3) return;

                    const nombre = celdas[1].textContent.trim();
                    const marca = celdas[2].textContent.trim();
                    const imagenOriginal = celdas[0].querySelector("img");

                    const opcion = document.createElement("button");
                    opcion.type = "button";
                    opcion.className =
                        "list-group-item list-group-item-action d-flex align-items-center gap-3 text-start";

                    if (imagenOriginal) {
                        const imagen = document.createElement("img");
                        imagen.src = imagenOriginal.src;
                        imagen.alt = nombre;
                        imagen.style.width = "42px";
                        imagen.style.height = "48px";
                        imagen.style.objectFit = "contain";
                        imagen.loading = "lazy";
                        opcion.appendChild(imagen);
                    }

                    const informacion = document.createElement("div");
                    informacion.className = "d-flex flex-column";

                    const titulo = document.createElement("span");
                    titulo.className = "fw-semibold";
                    titulo.textContent = nombre;

                    const detalle = document.createElement("small");
                    detalle.className = "text-muted";
                    detalle.textContent = "Marca: " + marca;

                    informacion.appendChild(titulo);
                    informacion.appendChild(detalle);
                    opcion.appendChild(informacion);

                    opcion.addEventListener("click", function() {
                        campoBuscar.value = nombre;
                        ocultarSugerencias();
                        buscarEnServidor(false);
                    });

                    sugerencias.appendChild(opcion);
                });

                sugerencias.style.display = "block";
            }

            async function buscarEnServidor(mostrarListado = false) {
                clearTimeout(temporizador);

                temporizador = setTimeout(async function() {
                    if (controladorActual) controladorActual.abort();

                    const controlador = new AbortController();
                    controladorActual = controlador;

                    const parametros = new URLSearchParams(new FormData(formulario));
                    const url = formulario.action + "?" + parametros.toString();

                    try {
                        resultados.style.opacity = "0.5";

                        const respuesta = await fetch(url, {
                            method: "GET",
                            headers: { "X-Requested-With": "XMLHttpRequest" },
                            signal: controlador.signal
                        });

                        if (!respuesta.ok) {
                            throw new Error("Error al consultar los productos.");
                        }

                        const html = await respuesta.text();
                        const documento = new DOMParser().parseFromString(html, "text/html");
                        const nuevosResultados = documento.getElementById("resultadosCatalogo");

                        if (!nuevosResultados) {
                            throw new Error("La respuesta no contiene los resultados del catálogo.");
                        }

                        if (controlador !== controladorActual) return;

                        const filas = Array.from(nuevosResultados.querySelectorAll("tbody tr"));
                        resultados.innerHTML = nuevosResultados.innerHTML;

                        if (mostrarListado) {
                            mostrarSugerencias(filas);
                        } else {
                            ocultarSugerencias();
                        }
                    } catch (error) {
                        if (error.name !== "AbortError") {
                            console.error("Error en la búsqueda:", error);
                        }
                    } finally {
                        if (controlador === controladorActual) {
                            resultados.style.opacity = "1";
                        }
                    }
                }, 150);
            }

            campoBuscar.addEventListener("input", function() {
                buscarEnServidor(true);
            });

            campoCategoria.addEventListener("change", function() {
                buscarEnServidor(false);
            });

            campoMarca.addEventListener("change", function() {
                buscarEnServidor(false);
            });

            formulario.addEventListener("submit", function(evento) {
                evento.preventDefault();
                buscarEnServidor(false);
            });

            document.addEventListener("click", function(evento) {
                if (!sugerencias.parentElement.contains(evento.target)) {
                    ocultarSugerencias();
                }
            });

            campoBuscar.addEventListener("keydown", function(evento) {
                if (evento.key === "Escape") ocultarSugerencias();
            });
        });
    </script>

    @if (esAdministrador)
    {
        <style>
            [v-cloak] {
                display: none !important;
            }
        </style>

        <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>

        <!-- ABM REACTIVO DE PRODUCTOS -->
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                const elemento = document.getElementById("appProductosVue");

                if (!elemento) {
                    console.error("No se encontró el elemento #appProductosVue.");
                    return;
                }

                if (!window.Vue) {
                    console.error("No se pudo cargar Vue 3.");
                    return;
                }

                Vue.createApp({
                    data() {
                        return {
                            productos: [],
                            marcas: [],
                            categorias: [],
                            cargandoMarcas: false,
                            cargandoCategorias: false,
                            temporizadorMarca: null,
                            temporizadorCategoria: null,
                            cargando: false,
                            guardando: false,
                            mostrarFormulario: false,
                            editando: false,
                            mensaje: "",
                            esError: false,
                            form: this.formularioInicial()
                        };
                    },

                    methods: {
                        formularioInicial() {
                            return {
                                idProducto: 0,
                                nombre: "",
                                descripcion: "",
                                precio: 0,
                                stock: 0,
                                volumenMl: 100,
                                concentracion: "",
                                idMarca: null,
                                idCategoria: null,
                                marcaBusqueda: "",
                                categoriaBusqueda: "",
                                imagenUrl: "",
                                archivoImagen: null,
                                vistaPrevia: ""
                            };
                        },

                        formularioVacio() {
                            return this.formularioInicial();
                        },

                        async cargarProductos() {
                            this.cargando = true;

                            try {
                                const respuesta = await fetch("/api/productos");

                                if (!respuesta.ok) {
                                    throw new Error("No se pudieron cargar los productos.");
                                }

                                const datos = await respuesta.json();

                                this.productos = Array.isArray(datos)
                                    ? datos
                                    : (datos.$values || datos.items || []);
                            } catch (error) {
                                this.mensaje = error.message;
                                this.esError = true;
                                console.error(error);
                            } finally {
                                this.cargando = false;
                            }
                        },

                        buscarMarcas() {
                            this.form.idMarca = null;
                            this.marcas = [];
                            clearTimeout(this.temporizadorMarca);

                            const termino = this.form.marcaBusqueda.trim();

                            if (!termino) {
                                this.cargandoMarcas = false;
                                return;
                            }

                            this.cargandoMarcas = true;

                            this.temporizadorMarca = setTimeout(() => {
                                this.consultarMarcas(termino);
                            }, 300);
                        },

                        async consultarMarcas(termino) {
                            try {
                                const respuesta = await fetch(
                                    "/api/marca/buscar?termino=" +
                                    encodeURIComponent(termino)
                                );

                                if (!respuesta.ok) {
                                    throw new Error("No se pudieron buscar las marcas.");
                                }

                                const datos = await respuesta.json();

                                if (this.form.marcaBusqueda.trim() !== termino) return;

                                this.marcas = Array.isArray(datos) ? datos : [];
                            } catch (error) {
                                this.marcas = [];
                                this.mensaje = error.message;
                                this.esError = true;
                                console.error(error);
                            } finally {
                                if (this.form.marcaBusqueda.trim() === termino) {
                                    this.cargandoMarcas = false;
                                }
                            }
                        },

                        seleccionarMarca(marca) {
                            this.form.idMarca = Number(marca.idMarca);
                            this.form.marcaBusqueda = marca.nombre;
                            this.marcas = [];
                            this.cargandoMarcas = false;
                            clearTimeout(this.temporizadorMarca);
                        },

                        buscarCategorias() {
                            this.form.idCategoria = null;
                            this.categorias = [];
                            clearTimeout(this.temporizadorCategoria);

                            const termino = this.form.categoriaBusqueda.trim();

                            if (!termino) {
                                this.cargandoCategorias = false;
                                return;
                            }

                            this.cargandoCategorias = true;

                            this.temporizadorCategoria = setTimeout(() => {
                                this.consultarCategorias(termino);
                            }, 300);
                        },

                        async consultarCategorias(termino) {
                            try {
                                const respuesta = await fetch(
                                    "/api/categoria/buscar?termino=" +
                                    encodeURIComponent(termino)
                                );

                                if (!respuesta.ok) {
                                    throw new Error("No se pudieron buscar las categorías.");
                                }

                                const datos = await respuesta.json();

                                if (this.form.categoriaBusqueda.trim() !== termino) return;

                                this.categorias = Array.isArray(datos) ? datos : [];
                            } catch (error) {
                                this.categorias = [];
                                this.mensaje = error.message;
                                this.esError = true;
                                console.error(error);
                            } finally {
                                if (this.form.categoriaBusqueda.trim() === termino) {
                                    this.cargandoCategorias = false;
                                }
                            }
                        },

                        seleccionarCategoria(categoria) {
                            this.form.idCategoria = Number(categoria.idCategoria);
                            this.form.categoriaBusqueda = categoria.nombre;
                            this.categorias = [];
                            this.cargandoCategorias = false;
                            clearTimeout(this.temporizadorCategoria);
                        },

                        nuevoProducto() {
                            this.limpiarBusquedas();
                            this.form = this.formularioVacio();
                            this.editando = false;
                            this.mostrarFormulario = true;
                            this.mensaje = "";
                            this.esError = false;

                            const input = document.getElementById("vueArchivoImagen");
                            if (input) input.value = "";
                        },

                        editarProducto(producto) {
                            this.limpiarBusquedas();

                            this.form = {
                                idProducto: producto.idProducto,
                                nombre: producto.nombre || "",
                                descripcion: producto.descripcion || "",
                                precio: Number(producto.precio) || 0,
                                stock: Number(producto.stock) || 0,
                                volumenMl: Number(producto.volumenMl) || 100,
                                concentracion: producto.concentracion || "",
                                idMarca: producto.idMarca == null
                                    ? null : Number(producto.idMarca),
                                idCategoria: producto.idCategoria == null
                                    ? null : Number(producto.idCategoria),
                                marcaBusqueda: producto.marca?.nombre || "",
                                categoriaBusqueda: producto.categoria?.nombre || "",
                                imagenUrl: producto.imagenUrl || "",
                                archivoImagen: null,
                                vistaPrevia: producto.imagenUrl || ""
                            };

                            this.marcas = [];
                            this.categorias = [];
                            this.editando = true;
                            this.mostrarFormulario = true;
                            this.mensaje = "";
                            this.esError = false;

                            const input = document.getElementById("vueArchivoImagen");
                            if (input) input.value = "";
                        },

                        limpiarBusquedas() {
                            clearTimeout(this.temporizadorMarca);
                            clearTimeout(this.temporizadorCategoria);
                            this.marcas = [];
                            this.categorias = [];
                            this.cargandoMarcas = false;
                            this.cargandoCategorias = false;
                        },

                        cancelarFormulario() {
                            this.limpiarBusquedas();
                            this.mostrarFormulario = false;
                            this.form = this.formularioVacio();

                            const input = document.getElementById("vueArchivoImagen");
                            if (input) input.value = "";
                        },

                        seleccionarImagen(evento) {
                            const archivo = evento.target.files[0];
                            if (!archivo) return;

                            const tiposPermitidos = [
                                "image/jpeg",
                                "image/png",
                                "image/webp"
                            ];

                            if (!tiposPermitidos.includes(archivo.type)) {
                                alert("Seleccioná una imagen JPG, PNG o WEBP.");
                                evento.target.value = "";
                                return;
                            }

                            if (archivo.size > 2 * 1024 * 1024) {
                                alert("La imagen no puede superar los 2 MB.");
                                evento.target.value = "";
                                return;
                            }

                            if (
                                this.form.vistaPrevia &&
                                this.form.vistaPrevia.startsWith("blob:")
                            ) {
                                URL.revokeObjectURL(this.form.vistaPrevia);
                            }

                            this.form.archivoImagen = archivo;
                            this.form.vistaPrevia = URL.createObjectURL(archivo);
                        },

                        quitarImagenSeleccionada() {
                            if (
                                this.form.vistaPrevia &&
                                this.form.vistaPrevia.startsWith("blob:")
                            ) {
                                URL.revokeObjectURL(this.form.vistaPrevia);
                            }

                            this.form.archivoImagen = null;
                            this.form.vistaPrevia = this.form.imagenUrl || "";

                            const input = document.getElementById("vueArchivoImagen");
                            if (input) input.value = "";
                        },

                        async guardarProducto() {
                            if (this.guardando) return;

                            if (!this.form.idMarca || !this.form.idCategoria) {
                                this.mensaje =
                                    "Seleccioná una marca y una categoría de las sugerencias.";
                                this.esError = true;
                                return;
                            }

                            this.guardando = true;
                            this.mensaje = "";

                            const esEdicion = this.editando;
                            const url = esEdicion
                                ? "/api/productos/" + this.form.idProducto
                                : "/api/productos";

                            const datos = new FormData();

                            if (esEdicion) {
                                datos.append("idProducto", String(this.form.idProducto));
                            }

                            datos.append("nombre", this.form.nombre);
                            datos.append("descripcion", this.form.descripcion || "");
                            datos.append("precio", String(this.form.precio));
                            datos.append("stock", String(this.form.stock));
                            datos.append("volumenMl", String(this.form.volumenMl));
                            datos.append("concentracion", this.form.concentracion);
                            datos.append("idMarca", String(this.form.idMarca));
                            datos.append("idCategoria", String(this.form.idCategoria));

                            if (this.form.archivoImagen) {
                                datos.append("archivoImagen", this.form.archivoImagen);
                            }

                            try {
                                const respuesta = await fetch(url, {
                                    method: esEdicion ? "PUT" : "POST",
                                    body: datos
                                });

                                if (!respuesta.ok) {
                                    const texto = await respuesta.text();
                                    let mensajeError =
                                        texto || "No se pudo guardar el perfume.";

                                    try {
                                        const detalle = JSON.parse(texto);
                                        mensajeError = detalle.mensaje
                                            || detalle.title
                                            || mensajeError;
                                    } catch {
                                        // La respuesta no era JSON.
                                    }

                                    throw new Error(mensajeError);
                                }

                                this.mensaje = esEdicion
                                    ? "Perfume actualizado correctamente."
                                    : "Perfume creado correctamente.";

                                this.esError = false;
                                this.mostrarFormulario = false;
                                this.limpiarBusquedas();
                                this.form = this.formularioVacio();

                                const input = document.getElementById("vueArchivoImagen");
                                if (input) input.value = "";

                                await this.cargarProductos();
                            } catch (error) {
                                this.mensaje = error.message;
                                this.esError = true;
                                console.error("Error al guardar el perfume:", error);
                            } finally {
                                this.guardando = false;
                            }
                        },

                        
async eliminarProducto(producto) {
    const confirmar = confirm(
        "¿Querés eliminar el perfume " + producto.nombre + "?"
    );

    if (!confirmar) return;

    this.mensaje = "";
    this.esError = false;

    try {
        const respuesta = await fetch(
            "/api/productos/" + producto.idProducto,
            { method: "DELETE" }
        );

        if (!respuesta.ok) {
            const texto = await respuesta.text();
            let mensajeError =
                "No se pudo eliminar el perfume. Intentá nuevamente.";

            if (texto) {
                try {
                    const detalle = JSON.parse(texto);

                    mensajeError =
                        detalle.mensaje ||
                        detalle.title ||
                        mensajeError;
                } catch {

                }
            }

            throw new Error(mensajeError);
        }

        this.mensaje =
            "El perfume se eliminó correctamente del catálogo.";
        this.esError = false;

        await this.cargarProductos();

    } catch (error) {
        this.mensaje = error.message ||
            "Ocurrió un error al intentar eliminar el perfume.";
        this.esError = true;

        console.error("Error al eliminar el perfume:", error);
    }
},


