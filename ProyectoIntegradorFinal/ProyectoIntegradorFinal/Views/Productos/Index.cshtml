@model IEnumerable<ProyectoIntegradorFinal.Models.Producto>

@{
    ViewData["Title"] = "Catálogo de Perfumes";
    bool esAdministrador = User.IsInRole("Administrador");
    bool esCliente = User.IsInRole("Cliente");
    int paginaActual = ViewBag.PaginaActual;
    int totalPaginas = ViewBag.TotalPaginas;

}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
        <div>
            <span class="text-uppercase small"
                  style="letter-spacing: .15em; color: #96713D;">
                HOME ELIXIR
            </span>

            <h2 class="mt-2">Catálogo de perfumes</h2>

            <p class="text-muted mb-0">
                Explorá las fragancias y encontrá tu próxima esencia.
            </p>
        </div>

        @if (esAdministrador)
        {
            <a asp-action="Create" class="btn btn-dark">
                <i class="fas fa-plus me-2"></i>
                Agregar perfume
            </a>
        }
    </div>

    <hr class="mb-4" />

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Mensaje"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- BÚSQUEDA Y FILTROS -->
    <form id="buscarForm"
          asp-controller="Productos"
          asp-action="Index"
          method="get"
          class="p-3 p-md-4 mb-4"
          style="background: #F7F1E8; border: 1px solid #E5D8C5;">

        <div class="row g-3 align-items-end">

            <!-- BUSCADOR CON AUTOCOMPLETADO -->
            <div class="col-12 col-md-4">
                <label for="buscar" class="form-label">
                    Buscar perfume o marca
                </label>

                <div class="position-relative">
                    <input type="text"
                           id="buscar"
                           name="buscar"
                           value="@ViewBag.Buscar"
                           class="form-control"
                           placeholder="Ej.: Oud Wood, Dior..."
                           autocomplete="off"
                           aria-autocomplete="list"
                           aria-controls="sugerenciasBusqueda" />

                    <div id="sugerenciasBusqueda"
                         class="list-group position-absolute w-100 shadow"
                         style="display: none; z-index: 1050; max-height: 320px; overflow-y: auto;">
                    </div>
                </div>
            </div>

            <!-- FILTRO POR CATEGORÍA -->
            <div class="col-12 col-md-3">
                <label for="idCategoria" class="form-label">
                    Categoría
                </label>

                <select id="idCategoria"
                        name="idCategoria"
                        class="form-select">

                    <option value="">Todas las categorías</option>

                    @foreach (var categoria in
                        (IEnumerable<ProyectoIntegradorFinal.Models.Categoria>)ViewBag.Categorias)
                    {
                        if (ViewBag.IdCategoria != null &&
                            (int)ViewBag.IdCategoria == categoria.IdCategoria)
                        {
                            <option value="@categoria.IdCategoria" selected>
                                @categoria.Nombre
                            </option>
                        }
                        else
                        {
                            <option value="@categoria.IdCategoria">
                                @categoria.Nombre
                            </option>
                        }
                    }
                </select>
            </div>

            <!-- FILTRO POR MARCA -->
            <div class="col-12 col-md-3">
                <label for="idMarca" class="form-label">
                    Marca
                </label>

                <select id="idMarca"
                        name="idMarca"
                        class="form-select">

                    <option value="">Todas las marcas</option>

                    @foreach (var marca in
                        (IEnumerable<ProyectoIntegradorFinal.Models.Marca>)ViewBag.Marcas)
                    {
                        if (ViewBag.IdMarca != null &&
                            (int)ViewBag.IdMarca == marca.IdMarca)
                        {
                            <option value="@marca.IdMarca" selected>
                                @marca.Nombre
                            </option>
                        }
                        else
                        {
                            <option value="@marca.IdMarca">
                                @marca.Nombre
                            </option>
                        }
                    }
                </select>
            </div>

            <!-- BOTONES -->
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-dark flex-grow-1">
                    <i class="fas fa-search me-1"></i>
                    Buscar
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary"
                   title="Limpiar filtros"
                   aria-label="Limpiar filtros">
                    <i class="fas fa-rotate-left"></i>
                </a>
            </div>

        </div>
    </form>

    <!-- RESULTADOS DEL CATÁLOGO -->
    <div id="resultadosCatalogo">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Fragancias disponibles</h5>

            <span class="text-muted small">
                @Model.Count() resultados
            </span>
        </div>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Imagen</th>
                            <th>Nombre</th>
                            <th>Marca</th>
                            <th>Descripción</th>
                            <th>Categoría</th>
                            <th>Presentación</th>
                            <th>Precio</th>

                            @if (esCliente)
                            {
                                <th>Carrito</th>
                            }

                            @if (esAdministrador)
                            {
                                <th>Stock</th>
                                <th>Acciones</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.ImagenUrl))
                                    {
                                        <img src="@item.ImagenUrl"
                                             alt="@item.Nombre"
                                             loading="lazy"
                                             style="width: 60px; height: 70px; object-fit: contain;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            Sin imagen
                                        </span>
                                    }
                                </td>

                                <td class="fw-semibold">
                                    @item.Nombre
                                </td>

                                <td>
                                    @(item.Marca?.Nombre ?? "Sin marca")
                                </td>

                                <td style="min-width: 200px; white-space: normal;">
                                    @(string.IsNullOrWhiteSpace(item.Descripcion)
                                        ? "Sin descripción"
                                        : item.Descripcion)
                                </td>

                                <td>
                                    @(item.Categoria?.Nombre ?? "Sin categoría")
                                </td>

                                <td>
                                    @item.VolumenMl ml
                                    <br />
                                    <small class="text-muted">
                                        @item.Concentracion
                                    </small>
                                </td>

                                <td class="fw-semibold">
                                    @item.Precio.ToString("C")
                                </td>

                                @if (esCliente)
                                {
                                    <td>
                                        <form asp-controller="Carrito"
                                              asp-action="Agregar"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="IdProducto"
                                                   value="@item.IdProducto" />

                                            <input type="hidden"
                                                   name="cantidad"
                                                   value="1" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-dark"
                                                    disabled="@(item.Stock < 1)"
                                                    title="@(item.Stock < 1 ? "Sin stock disponible" : "Agregar al carrito")">
                                                <i class="fas fa-shopping-bag me-1"></i>
                                                @(item.Stock < 1 ? "Sin stock" : "Agregar")
                                            </button>
                                        </form>
                                    </td>
                                }

                                @if (esAdministrador)
                                {
                                    <td>
                                        @item.Stock
                                    </td>

                                    <td>
                                        <div class="d-flex flex-wrap gap-2">
                                            <a asp-action="Edit"
                                               asp-route-id="@item.IdProducto"
                                               class="btn btn-sm btn-warning">
                                                Editar
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.IdProducto"
                                               class="btn btn-sm btn-danger">
                                                Eliminar
                                            </a>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5"
                 style="background: #F7F1E8; border: 1px solid #E5D8C5;">

                <i class="fas fa-wind fa-2x mb-3"
                   style="color: #B08D57;"></i>

                <h4>No encontramos fragancias</h4>

                <p class="text-muted">
                    Probá con otro nombre o cambiá los filtros.
                </p>

                <a asp-action="Index" class="btn btn-outline-dark">
                    Ver todo el catálogo
                </a>
            </div>
        }
        <!-- Botones de Paginación -->
        @if (totalPaginas > 1)
        {
            <nav aria-label="Paginación de productos" class="mt-4">
                <ul class="pagination justify-content-center">
            
                    <!-- Botón Anterior -->
                    <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual - 1)">Anterior</a>
                    </li>

                    <!-- Números de páginas dinámicos -->
                    @for (int i = 1; i <= totalPaginas; i++)
                    {
                        <li class="page-item @(i == paginaActual ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@i">@i</a>
                        </li>
                    }

                    <!-- Botón Siguiente -->
                    <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual + 1)">Siguiente</a>
                    </li>

                </ul>
            </nav>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const formulario = document.getElementById("buscarForm");
            const resultados = document.getElementById("resultadosCatalogo");
            const sugerencias = document.getElementById("sugerenciasBusqueda");

            if (!formulario || !resultados || !sugerencias) {
                console.error("No se encontraron los elementos del buscador.");
                return;
            }

            const campoBuscar = formulario.querySelector('[name="buscar"]');
            const campoCategoria = formulario.querySelector('[name="idCategoria"]');
            const campoMarca = formulario.querySelector('[name="idMarca"]');

            let temporizador;
            let controladorActual;

            function ocultarSugerencias() {
                sugerencias.innerHTML = "";
                sugerencias.style.display = "none";
            }

            function mostrarSugerencias(filas) {
                sugerencias.innerHTML = "";

                const termino = campoBuscar.value.trim();

                if (!termino) {
                    ocultarSugerencias();
                    return;
                }

                if (filas.length === 0) {
                    const mensaje = document.createElement("div");
                    mensaje.className = "list-group-item text-muted small";
                    mensaje.textContent = "No se encontraron perfumes.";
                    sugerencias.appendChild(mensaje);
                    sugerencias.style.display = "block";
                    return;
                }

                filas.slice(0, 8).forEach(function(fila) {
                    const celdas = fila.querySelectorAll("td");

                    if (celdas.length < 3) {
                        return;
                    }

                    const nombre = celdas[1].textContent.trim();
                    const marca = celdas[2].textContent.trim();
                    const imagenOriginal = celdas[0].querySelector("img");

                    const opcion = document.createElement("button");
                    opcion.type = "button";
                    opcion.className =
                        "list-group-item list-group-item-action d-flex align-items-center gap-3 text-start";

                    if (imagenOriginal) {
                        const imagen = document.createElement("img");
                        imagen.src = imagenOriginal.src;
                        imagen.alt = nombre;
                        imagen.style.width = "42px";
                        imagen.style.height = "48px";
                        imagen.style.objectFit = "contain";
                        imagen.loading = "lazy";

                        opcion.appendChild(imagen);
                    }

                    const informacion = document.createElement("div");
                    informacion.className = "d-flex flex-column";

                    const titulo = document.createElement("span");
                    titulo.className = "fw-semibold";
                    titulo.textContent = nombre;

                    const detalle = document.createElement("small");
                    detalle.className = "text-muted";
                    detalle.textContent = "Marca: " + marca;

                    informacion.appendChild(titulo);
                    informacion.appendChild(detalle);
                    opcion.appendChild(informacion);

                    opcion.addEventListener("click", function() {
                        campoBuscar.value = nombre;
                        ocultarSugerencias();
                        buscarEnServidor(false);
                    });

                    sugerencias.appendChild(opcion);
                });

                sugerencias.style.display = "block";
            }

            async function buscarEnServidor(mostrarListado = false) {
                clearTimeout(temporizador);

                temporizador = setTimeout(async function() {
                    if (controladorActual) {
                        controladorActual.abort();
                    }

                    const controlador = new AbortController();
                    controladorActual = controlador;

                    const parametros = new URLSearchParams(
                        new FormData(formulario)
                    );

                    const url =
                        formulario.action + "?" + parametros.toString();

                    try {
                        resultados.style.opacity = "0.5";

                        const respuesta = await fetch(url, {
                            method: "GET",
                            headers: {
                                "X-Requested-With": "XMLHttpRequest"
                            },
                            signal: controlador.signal
                        });

                        if (!respuesta.ok) {
                            throw new Error(
                                "Error al consultar los productos."
                            );
                        }

                        const html = await respuesta.text();

                        const documento = new DOMParser().parseFromString(
                            html,
                            "text/html"
                        );

                        const nuevosResultados =
                            documento.getElementById("resultadosCatalogo");

                        if (!nuevosResultados) {
                            throw new Error(
                                "La respuesta no contiene los resultados del catálogo."
                            );
                        }

                        // Ignorar respuestas de búsquedas anteriores.
                        if (controlador !== controladorActual) {
                            return;
                        }

                        const filas = Array.from(
                            nuevosResultados.querySelectorAll("tbody tr")
                        );

                        resultados.innerHTML = nuevosResultados.innerHTML;

                        if (mostrarListado) {
                            mostrarSugerencias(filas);
                        } else {
                            ocultarSugerencias();
                        }

                    } catch (error) {
                        if (error.name !== "AbortError") {
                            console.error("Error en la búsqueda:", error);
                        }
                    } finally {
                        if (controlador === controladorActual) {
                            resultados.style.opacity = "1";
                        }
                    }
                }, 150);
            }

            // Buscar al escribir y desplegar sugerencias.
            campoBuscar.addEventListener("input", function() {
                buscarEnServidor(true);
            });

            // Mantener los filtros existentes.
            campoCategoria.addEventListener("change", function() {
                buscarEnServidor(false);
            });

            campoMarca.addEventListener("change", function() {
                buscarEnServidor(false);
            });

            // El botón Buscar actualiza el catálogo sin desplegar sugerencias.
            formulario.addEventListener("submit", function(evento) {
                evento.preventDefault();
                buscarEnServidor(false);
            });

            // Cerrar al hacer clic fuera del campo y el desplegable.
            document.addEventListener("click", function(evento) {
                if (!sugerencias.parentElement.contains(evento.target)) {
                    ocultarSugerencias();
                }
            });

            // Cerrar con Escape.
            campoBuscar.addEventListener("keydown", function(evento) {
                if (evento.key === "Escape") {
                    ocultarSugerencias();
                }
            });
        });
    </script>
}
