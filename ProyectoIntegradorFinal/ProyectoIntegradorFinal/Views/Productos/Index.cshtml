@model IEnumerable<ProyectoIntegradorFinal.Models.Producto>

@{
    ViewData["Title"] = "Catálogo de Perfumes";
}

<div class="container mt-4">
    <h2>Catálogo de Perfumes</h2>
    <hr />

    <p>
        <a asp-action="Create" class="btn btn-dark">
            Agregar Nuevo Perfume
        </a>
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-hover mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Imagen</th>
                    <th>Nombre</th>
                    <th>Marca</th>
                    <th>Descripción</th>
                    <th>Categoría</th>
                    <th>Volumen</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="align-middle">
                            @if (!string.IsNullOrEmpty(item.ImagenUrl))
                            {
                                <img src="@item.ImagenUrl"
                                     alt="@item.Nombre"
                                     style="width: 50px; height: auto;" />
                            }
                            else
                            {
                                <span>Sin imagen</span>
                            }
                        </td>

                        <td class="align-middle">
                            @item.Nombre
                        </td>

                        <td class="align-middle">
                            @(item.Marca?.Nombre ?? "Sin marca")
                        </td>

                        <td class="align-middle" style="min-width: 250px; white-space: normal;">
                            @(string.IsNullOrWhiteSpace(item.Descripcion)
                                ? "Sin descripción"
                                : item.Descripcion)
                        </td>

                        <td class="align-middle">
                            @(item.Categoria?.Nombre ?? "Sin categoría")
                        </td>

                        <td class="align-middle">
                            @item.VolumenMl ml - @item.Concentracion
                        </td>

                        <td class="align-middle">
                            @item.Precio.ToString("C")
                        </td>

                        <td class="align-middle">
                            @item.Stock
                        </td>

                        <td class="align-middle">
                            <a asp-action="Edit"
                               asp-route-id="@item.IdProducto"
                               class="btn btn-sm btn-warning">Editar</a>

                            <a asp-action="Delete"
                               asp-route-id="@item.IdProducto"
                               class="btn btn-sm btn-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>