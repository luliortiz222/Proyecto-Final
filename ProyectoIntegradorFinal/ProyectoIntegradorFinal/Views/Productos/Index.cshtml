@model IEnumerable<ProyectoIntegradorFinal.Models.Producto>

@{
    ViewData["Title"] = "Catálogo de Perfumes";
}

<div class="container mt-4">
    <h2>Catálogo de Perfumes</h2>
    <hr />

    <p>
        <a asp-action="Create" class="btn btn-dark">Agregar Nuevo Perfume</a>
    </p>

    <table class="table table-striped table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>Imagen</th>
                <th>Nombre</th>
                <th>Marca</th>
                <th>Categoría</th>
                <th>Volumen</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImagenUrl))
                        {
                            <img src="@item.ImagenUrl" alt="@item.Nombre" style="width: 50px; height: auto;" />
                        }
                        else
                        {
                            <span>Sin imagen</span>
                        }
                    </td>
                    <td class="align-middle">@item.Nombre</td>
                    <td class="align-middle">@item.Marca.Nombre</td>
                    <td class="align-middle">@item.Categoria.Nombre</td>
                    <td class="align-middle">@item.VolumenMl ml - @item.Concentracion</td>
                    <td class="align-middle">$@item.Precio</td>
                    <td class="align-middle">@item.Stock</td>
                    <td class="align-middle">
                        <!-- Botones de acción futuros -->
                        <a asp-action="Edit" asp-route-id="@item.IdProducto" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.IdProducto" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>