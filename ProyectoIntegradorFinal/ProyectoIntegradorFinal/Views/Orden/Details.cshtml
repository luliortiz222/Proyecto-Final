@model ProyectoIntegradorFinal.Models.Orden

@{
    ViewData["Title"] = $"Orden #{Model.IdOrden}";
    bool esAdministrador = User.IsInRole("Administrador");
    var cultura = new System.Globalization.CultureInfo("es-AR");

    bool permiteEliminar = Model.Estado != "En camino"
                        && Model.Estado != "Finalizado"
                        && Model.Estado != "Enviado"
                        && Model.Estado != "Entregado";
}

<div class="container mt-4 mb-5">

    <!-- ENCABEZADO -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <span class="text-uppercase small"
                  style="letter-spacing: 3px; color: #B08D57;">
                HOME ELIXIR
            </span>

            <h2 class="fw-bold mt-2 mb-1">
                <i class="fas fa-receipt me-2" style="color: #B08D57;"></i>
                Orden #@Model.IdOrden
            </h2>

            <p class="text-muted mb-0">
                Detalle de la compra
            </p>
        </div>

        <a asp-controller="Orden"
           asp-action="Index"
           class="btn btn-outline-dark">
            <i class="fas fa-arrow-left me-1"></i>
            Volver a las órdenes
        </a>
    </div>

    <!-- MENSAJES -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Mensaje"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- INFORMACIÓN GENERAL -->
    <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
        <div class="card-body p-4">
            <div class="row g-4">

                <!-- DATOS DE LA ORDEN -->
                <div class="col-md-6">
                    <h5 class="fw-bold mb-3">
                        <i class="fas fa-file-invoice me-2" style="color: #B08D57;"></i>
                        Información de la orden
                    </h5>

                    <p>
                        <strong>Número:</strong>
                        #@Model.IdOrden
                    </p>

                    <p>
                        <strong>Fecha:</strong>
                        @Model.FechaOrden.ToString("dd/MM/yyyy HH:mm")
                    </p>

                    <p>
                        <strong>Estado:</strong>

                        @{
                            string claseEstado = Model.Estado switch
                            {
                                "Pendiente" => "bg-warning text-dark",
                                "Observado" => "bg-danger",
                                "En camino" => "bg-primary",
                                "Finalizado" => "bg-success",
                                "Procesando" => "bg-info text-dark",
                                "Enviado" => "bg-primary",
                                "Entregado" => "bg-success",
                                "Cancelado" => "bg-secondary",
                                _ => "bg-secondary"
                            };
                        }

                        <span class="badge @claseEstado">
                            @Model.Estado
                        </span>
                    </p>

                    <p class="fs-5 mb-0">
                        <strong>Total:</strong>
                        <span class="fw-bold" style="color: #96713D;">
                            @Model.Total.ToString("C", cultura)
                        </span>
                    </p>
                </div>

                <!-- DIRECCIÓN -->
                <div class="col-md-6">
                    <h5 class="fw-bold mb-3">
                        <i class="fas fa-map-marker-alt me-2" style="color: #B08D57;"></i>
                        Dirección de entrega
                    </h5>

                    @if (Model.Direccion != null)
                    {
                        <p class="mb-2">
                            @Model.Direccion.Calle
                            @Model.Direccion.Numero
                        </p>

                        <p class="mb-2">
                            @Model.Direccion.Ciudad,
                            @Model.Direccion.Provincia
                        </p>

                        <p class="mb-0">
                            <strong>Código postal:</strong>
                            @Model.Direccion.CodigoPostal
                        </p>
                    }
                    else
                    {
                        <p class="text-muted">
                            No hay una dirección disponible.
                        </p>
                    }
                </div>

                <!-- DATOS DEL CLIENTE: SOLO ADMINISTRADOR -->
                @if (esAdministrador)
                {
                    <div class="col-12">
                        <hr />

                        <h5 class="fw-bold mb-3">
                            <i class="fas fa-user me-2" style="color: #B08D57;"></i>
                            Datos del cliente
                        </h5>

                        @if (Model.Usuario != null)
                        {
                            <p>
                                <strong>Nombre:</strong>
                                @Model.Usuario.Nombre
                                @Model.Usuario.Apellido
                            </p>

                            <p class="mb-0">
                                <strong>Email:</strong>
                                @Model.Usuario.Email
                            </p>

                            <p class="mb-0">
                                <strong>DNI:</strong>
                                @Model.Usuario.Dni
                            </p>
                        }
                        else
                        {
                            <p class="text-muted">
                                No hay datos del cliente disponibles.
                            </p>
                        }
                    </div>
                }

            </div>
        </div>
    </div>

    <!-- CAMBIAR ESTADO: SOLO ADMINISTRADOR -->
    @if (esAdministrador)
    {
        <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">Cambiar estado de la orden</h5>

                <form asp-controller="Orden"
                      asp-action="CambiarEstado"
                      method="post"
                      id="formCambiarEstado">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" value="@Model.IdOrden" />

                    <div class="row g-3 align-items-end">
                        <div class="col-md-8">
                            <label for="estado" class="form-label">Estado</label>

                            <select id="estado" name="estado" class="form-select" required>
                                <option value="Pendiente" selected="@(Model.Estado == "Pendiente")">Pendiente</option>
                                <option value="Observado" selected="@(Model.Estado == "Observado")">Observado</option>
                                <option value="En camino" selected="@(Model.Estado == "En camino")">En camino</option>
                                <option value="Finalizado" selected="@(Model.Estado == "Finalizado")">Finalizado</option>
                                <option value="Cancelado" selected="@(Model.Estado == "Cancelado")">Cancelado</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <button type="button"
                                    id="btnAbrirConfirmacionEstado"
                                    class="btn w-100 text-white"
                                    style="background-color: #96713D;">
                                <i class="fas fa-save me-2"></i>
                                Guardar estado
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }

    <!-- PRODUCTOS DE LA ORDEN -->
    <div class="card shadow-sm border-0" style="border-radius: 12px;">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-4">
                <i class="fas fa-box-open me-2" style="color: #B08D57;"></i>
                Productos de la orden
            </h5>

            @if (Model.Detalles != null && Model.Detalles.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead style="background: #F7F1E8;">
                            <tr>
                                <th>Producto</th>
                                <th class="text-center">Cantidad</th>
                                <th class="text-end">Precio unitario</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var detalle in Model.Detalles)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">
                                            @(detalle.Producto?.Nombre ?? "Producto no disponible")
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        @detalle.Cantidad
                                    </td>

                                    <td class="text-end">
                                        @detalle.PrecioUnitario.ToString("C", cultura)
                                    </td>

                                    <td class="text-end fw-semibold">
                                        @((detalle.Cantidad * detalle.PrecioUnitario).ToString("C", cultura))
                                    </td>
                                </tr>
                            }
                        </tbody>

                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end fw-bold">
                                    Total de la orden
                                </td>

                                <td class="text-end fw-bold fs-5" style="color: #96713D;">
                                    @Model.Total.ToString("C", cultura)
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="p-3 rounded"
                     style="background: #F7F1E8; border: 1px solid #E5D8C5;">
                    <i class="fas fa-info-circle me-2" style="color: #B08D57;"></i>
                    Esta orden todavía no tiene productos asociados en sus detalles.
                </div>
            }

        </div>
    </div>

    <!-- ACCIONES DEL ADMINISTRADOR -->
    @if (esAdministrador)
    {
        <div class="card shadow-sm border-0 mt-4" style="border-radius: 12px;">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-2">
                    <i class="fas fa-tools me-2" style="color: #B08D57;"></i>
                    Acciones de administración
                </h5>

                @if (permiteEliminar)
                {
                    <p class="text-muted">
                        Si la orden se generó por error, podés eliminarla.
                    </p>

                    <button type="button"
                            class="btn btn-outline-danger"
                            data-bs-toggle="modal"
                            data-bs-target="#modalEliminarOrden">
                        <i class="fas fa-trash-alt me-2"></i>
                        Eliminar orden
                    </button>
                }
                else
                {
                    <p class="text-muted mb-0">
                        Esta orden ya fue enviada o finalizada y no se puede eliminar desde aquí.
                    </p>
                }
            </div>
        </div>
    }

    <!-- MODAL DE CONFIRMACIÓN DEL CAMBIO DE ESTADO -->
    @if (esAdministrador)
    {
        <div class="modal fade"
             id="modalConfirmarEstado"
             tabindex="-1"
             aria-labelledby="tituloConfirmarEstado"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="tituloConfirmarEstado">
                            Confirmar cambio de estado
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Cerrar"></button>
                    </div>

                    <div class="modal-body">
                        ¿Confirmás el cambio de estado de esta orden?

                        <p class="mt-3 mb-0">
                            <strong>Orden:</strong> #@Model.IdOrden
                        </p>

                        <p class="mb-0">
                            <strong>Nuevo estado:</strong>
                            <span id="nuevoEstadoConfirmacion"></span>
                        </p>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">
                            Volver
                        </button>

                        <button type="button"
                                id="btnConfirmarEstado"
                                class="btn text-white"
                                style="background-color: #96713D;">
                            Sí, confirmar cambio
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- MODAL DE CONFIRMACIÓN DE ELIMINACIÓN -->
        @if (permiteEliminar)
        {
            <div class="modal fade"
                 id="modalEliminarOrden"
                 tabindex="-1"
                 aria-labelledby="tituloModalEliminarOrden"
                 aria-hidden="true">

                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">

                        <div class="modal-header">
                            <h5 class="modal-title fw-bold"
                                id="tituloModalEliminarOrden">
                                <i class="fas fa-exclamation-triangle text-danger me-2"></i>
                                Confirmar eliminación
                            </h5>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Cerrar"></button>
                        </div>

                        <div class="modal-body">
                            ¿Estás seguro de que querés eliminar la orden
                            <strong>#@Model.IdOrden</strong>?

                            <p class="text-danger small mt-3 mb-0">
                                Esta acción eliminará la orden y sus detalles y pagos asociados.
                                No se puede deshacer.
                            </p>
                        </div>

                        <div class="modal-footer">
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    data-bs-dismiss="modal">
                                No, volver
                            </button>

                            <form asp-controller="Orden"
                                  asp-action="Eliminar"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@Model.IdOrden" />

                                <button type="submit"
                                        class="btn btn-danger">
                                    <i class="fas fa-trash-alt me-2"></i>
                                    Sí, eliminar orden
                                </button>
                            </form>
                        </div>

                    </div>
                </div>
            </div>
        }
    }

    <!-- BOTÓN INFERIOR -->
    <div class="mt-4">
        <a asp-controller="Orden"
           asp-action="Index"
           class="btn btn-outline-dark">
            <i class="fas fa-arrow-left me-2"></i>
            Volver a las órdenes
        </a>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const formulario = document.getElementById("formCambiarEstado");
            const selectorEstado = document.getElementById("estado");
            const botonAbrir = document.getElementById("btnAbrirConfirmacionEstado");
            const botonConfirmar = document.getElementById("btnConfirmarEstado");
            const textoEstado = document.getElementById("nuevoEstadoConfirmacion");
            const modalElemento = document.getElementById("modalConfirmarEstado");

            if (formulario && selectorEstado && botonAbrir &&
                botonConfirmar && textoEstado && modalElemento) {

                document.body.appendChild(modalElemento);

                botonAbrir.addEventListener("click", function () {
                            if (!selectorEstado.reportValidity()) {
                        return;
                    }

                    textoEstado.textContent =
                        selectorEstado.options[selectorEstado.selectedIndex].text;

                    bootstrap.Modal.getOrCreateInstance(modalElemento).show();
                        });

                botonConfirmar.addEventListener("click", function () {
                    formulario.requestSubmit();
                        });
            }
                });
    </script>
}