@model IEnumerable<ProyectoIntegradorFinal.Models.Orden>

@{
    ViewData["Title"] = "Mis órdenes";

    bool esAdministrador = User.IsInRole("Administrador");

    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;
    int registrosPorPagina = ViewBag.RegistrosPorPagina ?? 3;

    int primerRegistro = totalRegistros == 0
        ? 0
        : ((paginaActual - 1) * registrosPorPagina) + 1;

    int ultimoRegistro = Math.Min(
        paginaActual * registrosPorPagina,
        totalRegistros
    );
}

<div class="container mt-4 mb-5">

    <div class="mb-4">
        <span class="text-uppercase small"
              style="letter-spacing: 3px; color: #B08D57;">
            HOME ELIXIR
        </span>

        <h2 class="mt-2">
            @(esAdministrador ? "Gestión de órdenes" : "Mis órdenes")
        </h2>

        <p class="text-muted">
            @(esAdministrador
                ? "Consultá las órdenes realizadas por todos los clientes."
                : "Consultá tus compras, sus importes y el estado de cada pedido.")
        </p>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["Mensaje"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @TempData["Error"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    @if (totalRegistros == 0)
    {
        <div class="text-center py-5"
             style="background: #fff; border: 1px solid #E5D8C5; border-radius: 12px;">

            <i class="fas fa-box-open fa-3x mb-3"
               style="color: #B08D57;"></i>

            <h5>No hay órdenes registradas</h5>

            <p class="text-muted mb-0">
                @(esAdministrador
                    ? "Cuando se realicen compras, aparecerán en esta sección."
                    : "Cuando realices una compra, podrás consultar tu pedido aquí.")
            </p>
        </div>
    }
    else
    {
        <div class="table-responsive"
             style="background: #fff; border: 1px solid #E5D8C5; border-radius: 12px;">

            <table class="table table-hover align-middle mb-0">

                <thead style="background: #F7F1E8;">
                    <tr>
                        <th class="ps-3">N.º orden</th>

                        @if (esAdministrador)
                        {
                            <th>Cliente</th>
                        }

                        <th>Fecha</th>
                        <th>Dirección de entrega</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var orden in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold">
                                #@orden.IdOrden
                            </td>

                            @if (esAdministrador)
                            {
                                <td>
                                    @if (orden.Usuario != null)
                                    {
                                        @($"{orden.Usuario.Nombre} {orden.Usuario.Apellido}")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin información</span>
                                    }
                                </td>
                            }

                            <td>
                                @orden.FechaOrden.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @if (orden.Direccion != null)
                                {
                                    @($"{orden.Direccion.Calle} {orden.Direccion.Numero}, {orden.Direccion.Ciudad}")
                                }
                                else
                                {
                                    <span class="text-muted">Sin dirección</span>
                                }
                            </td>

                            <td class="fw-semibold">
                                @orden.Total.ToString(
                                    "C",
                                    new System.Globalization.CultureInfo("es-AR")
                                )
                            </td>

                            <td>
                                @{
                                    string claseEstado = orden.Estado?.ToLower() switch
                                    {
                                        "entregado" or "finalizado" => "bg-success",
                                        "cancelado" => "bg-danger",
                                        "enviado" or "en camino" => "bg-primary",
                                        "procesando" => "bg-info text-dark",
                                        "observado" => "bg-warning text-dark",
                                        "pendiente" => "bg-secondary",
                                        _ => "bg-secondary"
                                    };
                                }

                                <span class="badge @claseEstado">
                                    @orden.Estado
                                </span>
                            </td>

                            <td class="text-center">
                                <a asp-action="Details"
                                   asp-route-id="@orden.IdOrden"
                                   class="btn btn-sm btn-outline-dark">
                                    <i class="fas fa-eye me-1"></i>
                                    Ver detalle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 mt-3">

            <small class="text-muted">
                Mostrando @primerRegistro–@ultimoRegistro de @totalRegistros
                @(totalRegistros == 1 ? "orden" : "órdenes")
            </small>

            <nav aria-label="Paginación de órdenes">
                <ul class="pagination pagination-sm mb-0">

                    <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                        @if (paginaActual > 1)
                        {
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@(paginaActual - 1)"
                               style="color: #6F5128;">
                                <i class="fas fa-chevron-left me-1"></i>
                                Anterior
                            </a>
                        }
                        else
                        {
                            <span class="page-link">Anterior</span>
                        }
                    </li>

                    @for (int i = 1; i <= totalPaginas; i++)
                    {
                        <li class="page-item @(i == paginaActual ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@i"
                               aria-current="@(i == paginaActual ? "page" : null)"
                               style="@(i == paginaActual
                                                                  ? "background-color: #B08D57; border-color: #B08D57; color: white;"
                                                                  : "color: #6F5128;")">
                    @i
                </a>
            </li>
        }

        <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
            @if (paginaActual < totalPaginas)
            {
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pagina="@(paginaActual + 1)"
                   style="color: #6F5128;">
                    Siguiente
                    <i class="fas fa-chevron-right ms-1"></i>
                </a>
            }
            else
            {
                <span class="page-link">Siguiente</span>
            }
        </li>

    </ul>
</nav>
</div>
    }

<div class="mt-4">
    <a asp-controller="Productos"
       asp-action="Index"
       class="btn btn-outline-dark">
        <i class="fas fa-arrow-left me-2"></i>
        Volver al catálogo
    </a>
</div>

</div>
