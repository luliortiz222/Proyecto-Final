@model ProyectoIntegradorFinal.Models.Pago

@{
    ViewData["Title"] = "Detalle del pago";

    var cultura = System.Globalization.CultureInfo.GetCultureInfo("es-AR");

    bool esAdministrador = User.IsInRole("Administrador");

    var estado = (Model.EstadoPago ?? "").Trim().ToLowerInvariant();

    var claseEstado = estado switch
    {
        "aprobado" => "bg-success",
        "rechazado" => "bg-danger",
        "en revisión" => "bg-info text-dark",
        "en revision" => "bg-info text-dark",
        _ => "bg-warning text-dark"
    };
}

<div class="container mt-4 mb-5">

    <span class="text-uppercase small"
          style="letter-spacing: .15em; color: #96713D;">
        HOME ELIXIR
    </span>

    <h2 class="mt-2">
        Detalle del pago #@Model.IdPago
    </h2>

    <p class="text-muted">
        Información del pago y de la orden asociada.
    </p>

    <hr />

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Mensaje"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="row g-4">

        <!-- INFORMACIÓN DEL PAGO -->
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm h-100"
                 style="border-color: #E5D8C5;">

                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-credit-card me-2"
                           style="color: #B08D57;"></i>
                        Información del pago
                    </h5>
                </div>

                <div class="card-body p-4">

                    <div class="mb-3">
                        <span class="text-muted d-block small">
                            Número de pago
                        </span>
                        <strong>#@Model.IdPago</strong>
                    </div>

                    <div class="mb-3">
                        <span class="text-muted d-block small">
                            Fecha del pago
                        </span>
                        <strong>
                            @Model.FechaPago.ToString("dd/MM/yyyy HH:mm")
                        </strong>
                    </div>

                    <div class="mb-3">
                        <span class="text-muted d-block small">
                            Método de pago elegido por el cliente
                        </span>

                        <input type="text"
                               class="form-control"
                               value="@Model.MetodoPago"
                               readonly />

                        <div class="form-text">
                            El método de pago es fijo y no puede ser modificado por el administrador.
                        </div>
                    </div>

                    <div class="mb-3">
                        <span class="text-muted d-block small">
                            Importe
                        </span>
                        <h3 style="color: #96713D;">
                            @Model.Monto.ToString("C2", cultura)
                        </h3>
                    </div>

                    <div class="mb-4">
                        <span class="text-muted d-block small mb-1">
                            Estado del pago
                        </span>

                        <span class="badge @claseEstado fs-6">
                            @Model.EstadoPago
                        </span>
                    </div>

                    @if (esAdministrador)
                    {
                        <hr />

                        <!-- EL ADMINISTRADOR SOLO PUEDE CAMBIAR EL ESTADO -->
                        <h5 class="fw-bold mb-3">
                            <i class="fas fa-edit me-2"
                               style="color: #B08D57;"></i>
                            Actualizar estado del pago
                        </h5>

                        <p class="text-muted small">
                            Podés actualizar el estado del pago. El método seleccionado por el cliente no se puede modificar.
                        </p>

                        <form asp-controller="Pagos"
                              asp-action="CambiarEstado"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.IdPago" />

                            <div class="mb-3">
                                <label for="estadoPago"
                                       class="form-label fw-semibold">
                                    Estado del pago
                                </label>

                                <select id="estadoPago"
                                        name="estadoPago"
                                        class="form-select"
                                        required>

                                    <option value="Pendiente"
                                            selected="@(Model.EstadoPago == "Pendiente")">
                                        Pendiente
                                    </option>

                                    <option value="En revisión"
                                            selected="@(Model.EstadoPago == "En revisión" || Model.EstadoPago == "En revision")">
                                        En revisión
                                    </option>

                                    <option value="Aprobado"
                                            selected="@(Model.EstadoPago == "Aprobado")">
                                        Aprobado
                                    </option>

                                    <option value="Rechazado"
                                            selected="@(Model.EstadoPago == "Rechazado")">
                                        Rechazado
                                    </option>
                                </select>
                            </div>

                            <button type="submit"
                                    class="btn text-white w-100"
                                    style="background-color: #96713D;">
                                <i class="fas fa-save me-2"></i>
                                Guardar estado del pago
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>

        <!-- ORDEN ASOCIADA -->
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm h-100"
                 style="border-color: #E5D8C5;">

                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-box me-2"
                           style="color: #B08D57;"></i>
                        Orden asociada
                    </h5>
                </div>

                <div class="card-body p-4">

                    <div class="mb-3">
                        <span class="text-muted d-block small">
                            Número de orden
                        </span>
                        <strong>#@Model.IdOrden</strong>
                    </div>

                    @if (Model.Orden != null)
                    {
                        <div class="mb-3">
                            <span class="text-muted d-block small">
                                Fecha de la orden
                            </span>
                            <strong>
                                @Model.Orden.FechaOrden.ToString("dd/MM/yyyy")
                            </strong>
                        </div>

                        <div class="mb-3">
                            <span class="text-muted d-block small">
                                Total de la orden
                            </span>
                            <strong>
                                @Model.Orden.Total.ToString("C2", cultura)
                            </strong>
                        </div>

                        <div class="mb-3">
                            <span class="text-muted d-block small">
                                Estado de la orden
                            </span>
                            <strong>@Model.Orden.Estado</strong>
                        </div>

                        <a asp-controller="Orden"
                           asp-action="Details"
                           asp-route-id="@Model.IdOrden"
                           class="btn btn-outline-dark mt-2">
                            <i class="fas fa-eye me-2"></i>
                            Ver detalle de la orden
                        </a>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            No se encontraron los datos de la orden asociada.
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

    <div class="d-flex flex-wrap gap-2 mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>
            Volver a pagos
        </a>
    </div>

</div>