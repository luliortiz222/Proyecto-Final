@model IEnumerable<ProyectoIntegradorFinal.Models.Pago>

@{
    ViewData["Title"] = "Mis pagos";

    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;
}

<div class="container mt-4 mb-5 he-mis-pagos">

    <span class="text-uppercase small he-eyebrow-pagos">
        HOME ELIXIR
    </span>

    <div class="d-flex flex-wrap justify-content-between
        align-items-center mt-2 mb-4 gap-2">
        <div>
            <h2>Mis pagos</h2>
            <p class="text-muted mb-0">
                Consultá los pagos asociados a tus pedidos.
            </p>
        </div>

        <span class="badge rounded-pill he-badge-pagos px-3 py-2">
            @totalRegistros pagos
        </span>
    </div>

    <hr />

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["Mensaje"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    <div class="card shadow-sm he-card-pagos">
        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-receipt fa-3x mb-3
                    he-icono-pagos"></i>

                    <h5>Todavía no tenés pagos registrados</h5>

                    <p class="text-muted mb-0">
                        Cuando realices una compra, tus pagos aparecerán acá.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle
                        he-tabla-pagos">
                        <thead>
                            <tr>
                                <th>N.º de pago</th>
                                <th>N.º de orden</th>
                                <th>Fecha</th>
                                <th>Método de pago</th>
                                <th>Monto</th>
                                <th>Estado</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var pago in Model)
                            {
                                var estado = (pago.EstadoPago ?? "")
                                    .Trim()
                                    .ToLowerInvariant();

                                var claseEstado = estado switch
                                {
                                    "aprobado" => "he-estado-aprobado",
                                    "rechazado" => "he-estado-rechazado",
                                    "en revisión" => "he-estado-revision",
                                    "en revision" => "he-estado-revision",
                                    _ => "he-estado-pendiente"
                                };

                                <tr>
                                    <td>
                                        <strong>#@pago.IdPago</strong>
                                    </td>

                                    <td>
                                        #@pago.IdOrden
                                    </td>

                                    <td class="text-nowrap">
                                        @pago.FechaPago.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(pago.MetodoPago)
                                            ? "No especificado"
                                            : pago.MetodoPago)
                                    </td>

                                    <td class="text-nowrap">
                                        @pago.Monto.ToString(
                                            "C2",
                                            System.Globalization.CultureInfo.GetCultureInfo("es-AR"))
                                    </td>

                                    <td>
                                        <span class="badge @claseEstado">
                                            @pago.EstadoPago
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between
                    align-items-center flex-wrap gap-3 mt-4">

                    <span class="text-muted small">
                        Total de pagos: @totalRegistros
                    </span>

                    @if (totalPaginas > 1)
                    {
                        <nav aria-label="Paginación de mis pagos">
                            <ul class="pagination he-pagination mb-0">

                                <li class="page-item
                                    @(paginaActual <= 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-controller="Pagos"
                                       asp-action="MisPagos"
                                       asp-route-page="@(paginaActual - 1)">
                                        Anterior
                                    </a>
                                </li>

                                @for (int i = 1; i <= totalPaginas; i++)
                                {
                                    <li class="page-item
                                        @(i == paginaActual ? "active" : "")">
                                        <a class="page-link"
                                           asp-controller="Pagos"
                                           asp-action="MisPagos"
                                           asp-route-page="@i">
                                            @i
                                        </a>
                                    </li>
                                }

                                <li class="page-item
                                    @(paginaActual >= totalPaginas ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-controller="Pagos"
                                       asp-action="MisPagos"
                                       asp-route-page="@(paginaActual + 1)">
                                        Siguiente
                                    </a>
                                </li>

                            </ul>
                        </nav>
                    }
                </div>
            }
        </div>
    </div>
</div>
