@model IEnumerable<ProyectoIntegradorFinal.Models.Pago>

@{
    ViewData["Title"] = "Mis pagos";

    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;

    string metodoPago = ViewBag.MetodoPago as string ?? "";
    string estadoPago = ViewBag.EstadoPago as string ?? "";
}

<div class="container mt-4 mb-5 he-mis-pagos">

    <span class="text-uppercase small he-eyebrow-pagos">
        HOME ELIXIR
    </span>

    <div class="d-flex flex-wrap justify-content-between align-items-center mt-2 mb-4 gap-2">
        <div>
            <h2>Mis pagos</h2>
            <p class="text-muted mb-0">
                Consultá los pagos asociados a tus pedidos.
            </p>
        </div>

        <span id="contadorMisPagos"
              class="badge rounded-pill he-badge-pagos px-3 py-2">
            @totalRegistros pagos
        </span>
    </div>

    <hr />

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- BUSCADOR Y FILTRO -->
    <form id="formBuscarMisPagos"
          asp-controller="Pagos"
          asp-action="MisPagos"
          method="get"
          class="mb-4">

        <div class="card shadow-sm he-card-pagos">
            <div class="card-body">
                <div class="row g-3 align-items-end">

                    <div class="col-md-7">
                        <label for="buscarMetodoPago" class="form-label fw-semibold">
                            <i class="fas fa-search me-2"></i>
                            Buscar método de pago
                        </label>

                        <input type="search"
                               id="buscarMetodoPago"
                               name="metodoPago"
                               value="@metodoPago"
                               class="form-control"
                               placeholder="Ej.: tarjeta, transferencia..."
                               autocomplete="off" />
                    </div>

                    <div class="col-md-3">
                        <label for="filtrarEstadoPago" class="form-label fw-semibold">
                            <i class="fas fa-filter me-2"></i>
                            Estado del pago
                        </label>

                        <select id="filtrarEstadoPago"
                                name="estadoPago"
                                class="form-select">
                            <option value="">Todos los estados</option>
                            <option value="Pendiente"
                                    selected="@(estadoPago == "Pendiente")">
                                Pendiente
                            </option>
                            <option value="En revisión"
                                    selected="@(estadoPago == "En revisión")">
                                En revisión
                            </option>
                            <option value="Aprobado"
                                    selected="@(estadoPago == "Aprobado")">
                                Aprobado
                            </option>
                            <option value="Rechazado"
                                    selected="@(estadoPago == "Rechazado")">
                                Rechazado
                            </option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <a asp-controller="Pagos"
                           asp-action="MisPagos"
                           id="limpiarFiltrosMisPagos"
                           class="btn btn-outline-secondary w-100"
                           style="display:@(string.IsNullOrWhiteSpace(metodoPago) && string.IsNullOrWhiteSpace(estadoPago) ? "none" : "inline-block")">
                            <i class="fas fa-times me-1"></i>
                            Limpiar
                        </a>
                    </div>

                </div>

                <small id="estadoBusquedaMisPagos"
                       class="text-muted d-block mt-3"
                       aria-live="polite">
                    Los resultados se actualizan desde el servidor.
                </small>
            </div>
        </div>
    </form>

    <!-- RESULTADOS -->
    <div class="card shadow-sm he-card-pagos">
        <div class="card-body" id="contenidoMisPagos">

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle he-tabla-pagos">
                        <thead>
                            <tr>
                                <th>N.º de pago</th>
                                <th>N.º de orden</th>
                                <th>Fecha</th>
                                <th>Método de pago</th>
                                <th>Monto</th>
                                <th>Estado</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var pago in Model)
                            {
                                var estado = (pago.EstadoPago ?? "")
                                    .Trim()
                                    .ToLowerInvariant();

                                var claseEstado = estado switch
                                {
                                    "aprobado" => "he-estado-aprobado",
                                    "rechazado" => "he-estado-rechazado",
                                    "en revisión" => "he-estado-revision",
                                    "en revision" => "he-estado-revision",
                                    _ => "he-estado-pendiente"
                                };

                                <tr>
                                    <td>
                                        <strong>#@pago.IdPago</strong>
                                    </td>

                                    <td>#@pago.IdOrden</td>

                                    <td class="text-nowrap">
                                        @pago.FechaPago.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(pago.MetodoPago)
                                            ? "No especificado"
                                            : pago.MetodoPago)
                                    </td>

                                    <td class="text-nowrap">
                                        @pago.Monto.ToString(
                                            "C2",
                                            System.Globalization.CultureInfo.GetCultureInfo("es-AR"))
                                    </td>

                                    <td>
                                        <span class="badge @claseEstado">
                                            @pago.EstadoPago
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mt-4">

                    <span class="text-muted small">
                        Página @paginaActual de @totalPaginas
                    </span>

                    @if (totalPaginas > 1)
                    {
                        <nav aria-label="Paginación de mis pagos">
                            <ul class="pagination he-pagination mb-0">

                                <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-action="MisPagos"
                                       asp-route-page="@(paginaActual - 1)"
                                       asp-route-metodoPago="@metodoPago"
                                       asp-route-estadoPago="@estadoPago">
                                        Anterior
                                    </a>
                                </li>

                                @for (int i = 1; i <= totalPaginas; i++)
                                {
                                    <li class="page-item @(i == paginaActual ? "active" : "")">
                                        <a class="page-link"
                                           asp-action="MisPagos"
                                           asp-route-page="@i"
                                           asp-route-metodoPago="@metodoPago"
                                           asp-route-estadoPago="@estadoPago">
                                            @i
                                        </a>
                                    </li>
                                }

                                <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-action="MisPagos"
                                       asp-route-page="@(paginaActual + 1)"
                                       asp-route-metodoPago="@metodoPago"
                                       asp-route-estadoPago="@estadoPago">
                                        Siguiente
                                    </a>
                                </li>

                            </ul>
                        </nav>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-receipt fa-3x mb-3 he-icono-pagos"></i>

                    <h5>
                        @(string.IsNullOrWhiteSpace(metodoPago) &&
                          string.IsNullOrWhiteSpace(estadoPago)
                            ? "Todavía no tenés pagos registrados"
                            : "No se encontraron pagos")
                    </h5>

                    <p class="text-muted mb-0">
                        @(string.IsNullOrWhiteSpace(metodoPago) &&
                          string.IsNullOrWhiteSpace(estadoPago)
                            ? "Cuando realices una compra, tus pagos aparecerán acá."
                            : "Probá con otro método de pago o seleccioná otro estado.")
                    </p>
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const formulario = document.getElementById('formBuscarMisPagos');
            const buscador = document.getElementById('buscarMetodoPago');
            const selector = document.getElementById('filtrarEstadoPago');
            const limpiar = document.getElementById('limpiarFiltrosMisPagos');
            const estado = document.getElementById('estadoBusquedaMisPagos');
            const contenido = document.getElementById('contenidoMisPagos');
            const contador = document.getElementById('contadorMisPagos');

            if (!formulario || !buscador || !selector ||
                !limpiar || !estado || !contenido || !contador) {
                return;
            }

            let temporizador;
            let controladorActual = null;

            async function buscarPagos() {
                if (controladorActual) {
                    controladorActual.abort();
                }

                const controlador = new AbortController();
                controladorActual = controlador;

                const parametros = new URLSearchParams(
                    new FormData(formulario)
                );

                // Cada nueva búsqueda comienza en la primera página.
                parametros.delete('page');

                const url = formulario.action + '?' + parametros.toString();

                estado.textContent = 'Buscando pagos...';

                try {
                    const respuesta = await fetch(url, {
                        method: 'GET',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        signal: controlador.signal
                    });

                    if (!respuesta.ok) {
                        throw new Error('Error al consultar los pagos.');
                    }

                    const html = await respuesta.text();

                    const documento = new DOMParser().parseFromString(
                        html,
                        'text/html'
                    );

                    const nuevoContenido =
                        documento.getElementById('contenidoMisPagos');

                    const nuevoContador =
                        documento.getElementById('contadorMisPagos');

                    if (!nuevoContenido || !nuevoContador) {
                        throw new Error('No se recibieron los resultados esperados.');
                    }

                    if (controlador !== controladorActual) {
                        return;
                    }

                    contenido.innerHTML = nuevoContenido.innerHTML;
                    contador.textContent = nuevoContador.textContent.trim();

                    estado.textContent = 'Resultados actualizados.';
                }
                catch (error) {
                    if (error.name !== 'AbortError') {
                        console.error(error);
                        estado.textContent =
                            'No se pudo completar la búsqueda. Intentá nuevamente.';
                    }
                }
            }

            function programarBusqueda() {
                clearTimeout(temporizador);

                limpiar.style.display =
                    buscador.value.trim() || selector.value
                        ? 'inline-block'
                        : 'none';

                estado.textContent = 'Preparando búsqueda...';

                temporizador = setTimeout(buscarPagos, 300);
            }

            buscador.addEventListener('input', programarBusqueda);

            selector.addEventListener('change', () => {
                clearTimeout(temporizador);
                buscarPagos();
            });
        })();
    </script>
}
