@model ProyectoIntegradorFinal.Models.Usuario

@{
    ViewData["Title"] = "Crear cuenta";
}

<section class="registro-section py-5">
    <div class="container">
        <div class="card registro-card shadow-lg mx-auto">
            <div class="row g-0">

                <div class="col-lg-6">
                    <div class="registro-formulario p-4 p-md-5">

                        <div class="text-center mb-4">
                            <h1 class="registro-titulo fw-bold">
                                Crear una cuenta
                            </h1>
                            <p class="text-muted">
                                Descubrí tu próxima fragancia favorita.
                            </p>
                        </div>

                        <form asp-controller="Usuario"
                              asp-action="Registro"
                              method="post"
                              enctype="multipart/form-data">

                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3"></div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Nombre" class="form-label">
                                        Nombre
                                    </label>
                                    <input asp-for="Nombre"
                                           class="form-control"
                                           placeholder="Tu nombre" />
                                    <span asp-validation-for="Nombre"
                                          class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="Apellido" class="form-label">
                                        Apellido
                                    </label>
                                    <input asp-for="Apellido"
                                           class="form-control"
                                           placeholder="Tu apellido" />
                                    <span asp-validation-for="Apellido"
                                          class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Dni" class="form-label">
                                    DNI
                                </label>
                                <input asp-for="Dni"
                                       class="form-control"
                                       placeholder="Tu número de DNI" />
                                <span asp-validation-for="Dni"
                                      class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label">
                                    Correo electrónico
                                </label>
                                <input asp-for="Email"
                                       type="email"
                                       class="form-control"
                                       placeholder="tu@email.com" />
                                <span asp-validation-for="Email"
                                      class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label">
                                    Contraseña
                                </label>

                                <div class="input-group">
                                    <input asp-for="Password"
                                           type="password"
                                           id="Password"
                                           class="form-control"
                                           placeholder="Creá una contraseña"
                                           autocomplete="new-password" />

                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            onclick="alternarPassword('Password', this)"
                                            aria-label="Mostrar contraseña"
                                            title="Mostrar contraseña">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>

                                <span asp-validation-for="Password"
                                      class="text-danger"></span>
                            </div>

                            <!-- Avatar obligatorio con vista previa -->
                            <div class="mb-4">
                                <label for="avatarArchivo" class="form-label">
                                    Foto de perfil <span class="text-danger">*</span>
                                </label>

                                <div class="vista-previa-contenedor">
                                    <img id="vistaPreviaAvatar"
                                         alt="Vista previa de tu foto"
                                         class="vista-previa-avatar d-none" />

                                    <div id="placeholderAvatar"
                                         class="placeholder-avatar">
                                        Tu foto
                                    </div>
                                </div>

                                <input type="file"
                                       id="avatarArchivo"
                                       name="avatarArchivo"
                                       class="form-control"
                                       accept=".jpg,.jpeg,.png,.webp"
                                       required />

                                <small class="text-muted d-block mt-2">
                                    Formatos: JPG, JPEG, PNG o WEBP. Máximo 2 MB.
                                </small>

                                <div id="errorAvatar"
                                     class="text-danger mt-2"></div>
                            </div>

                            <button type="submit"
                                    class="btn btn-registro w-100">
                                Crear cuenta
                            </button>

                        </form>

                        <p class="text-center mt-4 mb-0">
                            ¿Ya tenés una cuenta?
                            <a asp-controller="Usuario"
                               asp-action="Login"
                               class="registro-link">
                                Iniciá sesión
                            </a>
                        </p>

                    </div>
                </div>

                <div class="col-lg-6 d-none d-lg-block">
                    <div class="registro-imagen h-100">
                        <img src="https://images.unsplash.com/photo-1541643600914-78b084683601?auto=format&fit=crop&w=1000&q=85"
                             alt="Frascos de perfumes"
                             class="img-fluid h-100 w-100" />

                        <div class="registro-frase">
                            <h2>Una esencia única.</h2>
                            <p>Encontrá la fragancia que habla de vos.</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Mostrar u ocultar la contraseña
        function alternarPassword(id, boton) {
            const campo = document.getElementById(id);
            const icono = boton.querySelector('i');

            if (campo.type === 'password') {
                campo.type = 'text';
                icono.classList.replace('fa-eye', 'fa-eye-slash');

                boton.setAttribute('aria-label', 'Ocultar contraseña');
                boton.setAttribute('title', 'Ocultar contraseña');
            } else {
                campo.type = 'password';
                icono.classList.replace('fa-eye-slash', 'fa-eye');

                boton.setAttribute('aria-label', 'Mostrar contraseña');
                boton.setAttribute('title', 'Mostrar contraseña');
            }
        }

        // Vista previa y validación del avatar
        document.addEventListener("DOMContentLoaded", function() {
            const inputFoto = document.getElementById("avatarArchivo");
            const vistaPrevia = document.getElementById("vistaPreviaAvatar");
            const placeholder = document.getElementById("placeholderAvatar");
            const error = document.getElementById("errorAvatar");

            if (!inputFoto || !vistaPrevia || !placeholder || !error) {
                return;
            }

            let urlAnterior = null;

            inputFoto.addEventListener("change", function() {
                error.textContent = "";

                const archivo = inputFoto.files[0];

                if (urlAnterior) {
                    URL.revokeObjectURL(urlAnterior);
                    urlAnterior = null;
                }

                vistaPrevia.classList.add("d-none");
                placeholder.classList.remove("d-none");

                if (!archivo) {
                    return;
                }

                const formatosPermitidos = [
                    "image/jpeg",
                    "image/png",
                    "image/webp"
                ];

                if (!formatosPermitidos.includes(archivo.type)) {
                    error.textContent = "Elegí una imagen JPG, PNG o WEBP.";
                    inputFoto.value = "";
                    return;
                }

                if (archivo.size > 2 * 1024 * 1024) {
                    error.textContent = "La imagen no puede superar los 2 MB.";
                    inputFoto.value = "";
                    return;
                }

                urlAnterior = URL.createObjectURL(archivo);
                vistaPrevia.src = urlAnterior;

                vistaPrevia.onload = function() {
                    vistaPrevia.classList.remove("d-none");
                    placeholder.classList.add("d-none");
                };

                vistaPrevia.onerror = function() {
                    error.textContent = "No se pudo mostrar la imagen.";
                    inputFoto.value = "";
                    vistaPrevia.classList.add("d-none");
                    placeholder.classList.remove("d-none");

                    if (urlAnterior) {
                        URL.revokeObjectURL(urlAnterior);
                        urlAnterior = null;
                    }
                };
            });
        });
    </script>
}