@model ProyectoIntegradorFinal.Models.Categoria

@{
    ViewData["Title"] = "Editar familia olfativa";
}

<div class="container mt-4 mb-5">

    <span class="text-uppercase small"
          style="letter-spacing: .15em; color: #96713D;">
        HOME ELIXIR
    </span>

    <h2 class="mt-2">Editar familia olfativa</h2>

    <p class="text-muted">
        Modificá el nombre de la categoría seleccionada.
    </p>

    <hr />

    <div class="card shadow-sm"
         style="max-width: 600px; border-color: #E5D8C5;">

        <div class="card-body p-4">

            <form asp-action="Edit"
                  asp-route-id="@Model.IdCategoria"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <input type="hidden"
                       asp-for="IdCategoria" />

                <div class="mb-4">
                    <label asp-for="Nombre"
                           class="form-label">
                        Nombre de la familia olfativa
                    </label>

                    <input asp-for="Nombre"
                           class="form-control"
                           placeholder="Ej.: Amaderada" />

                    <span asp-validation-for="Nombre"
                          class="text-danger">
                    </span>
                </div>

                <div class="d-flex flex-wrap gap-2">

                    <button type="submit"
                            class="btn btn-dark">
                        <i class="fas fa-save me-2"></i>
                        Guardar cambios
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}