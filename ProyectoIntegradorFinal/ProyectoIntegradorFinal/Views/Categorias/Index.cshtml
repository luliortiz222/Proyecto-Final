@using System.Linq
@model IEnumerable<ProyectoIntegradorFinal.Models.Categoria>

@{
    ViewData["Title"] = "Familias olfativas";

    string buscar = ViewBag.Buscar as string ?? "";
    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 0;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;
}

<div class="container mt-4 mb-5 he-categorias">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="he-etiqueta">HOME ELIXIR</span>
            <h2 class="he-titulo mt-2">Familias olfativas</h2>
            <p class="text-muted mb-0">
                Administrá las familias que definen cada fragancia.
            </p>
        </div>

        <a asp-action="Create" class="btn he-btn-dorado">
            <i class="fas fa-plus me-2"></i>
            Nueva categoría
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Mensaje"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    <!-- BUSCADOR AUTOMÁTICO -->
    <form id="formBuscarCategorias"
          asp-controller="Categorias"
          asp-action="Index"
          method="get"
          class="he-buscador mb-4">

        <div class="input-group">
            <span class="input-group-text he-icono-busqueda">
                <i class="fas fa-search"></i>
            </span>

            <input type="search"
                   id="buscarCategorias"
                   name="buscar"
                   value="@buscar"
                   class="form-control"
                   placeholder="Buscar familia olfativa..."
                   aria-label="Buscar familia olfativa"
                   autocomplete="off" />

            <a asp-action="Index"
               id="limpiarBusquedaCategorias"
               class="btn he-btn-limpiar"
               style="display: @(string.IsNullOrWhiteSpace(buscar) ? "none" : "inline-block")">
                <i class="fas fa-times me-1"></i>
                Limpiar
            </a>
        </div>

        <small id="estadoBusquedaCategorias"
               class="text-muted d-block mt-2"
               aria-live="polite">
            Escribí una letra o el nombre de una familia olfativa para buscar.
        </small>
    </form>

    <!-- TABLA DE CATEGORÍAS -->
    <div class="he-tabla-contenedor">
        <div class="table-responsive">
            <table class="table he-tabla align-middle mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Familia olfativa</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody id="tablaCategorias">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var categoria in Model)
                        {
                            <tr>
                                <td>@categoria.IdCategoria</td>

                                <td class="fw-semibold">
                                    @categoria.Nombre
                                </td>

                                <td class="text-end">
                                    <a asp-action="Edit"
                                       asp-route-id="@categoria.IdCategoria"
                                       class="btn btn-sm he-btn-editar">
                                        <i class="fas fa-pen me-1"></i>
                                        Editar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5">
                                <i class="fas fa-wind he-icono-vacio"></i>

                                <p class="mt-3 mb-1 fw-semibold">
                                    No se encontraron familias olfativas.
                                </p>

                                <span class="text-muted">
                                    Probá con otra letra o palabra.
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- RESULTADOS Y PAGINACIÓN -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mt-3">

        <small class="text-muted" id="contadorCategorias">
            Resultados: @totalRegistros
        </small>

        <nav id="contenedorPaginacionCategorias"
             aria-label="Paginación de familias olfativas">

            @if (totalPaginas > 1)
            {
                <ul class="pagination he-paginacion mb-0">

                    <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-buscar="@buscar"
                           asp-route-pagina="@(paginaActual - 1)">
                            Anterior
                        </a>
                    </li>

                    @for (int i = 1; i <= totalPaginas; i++)
                    {
                        <li class="page-item @(i == paginaActual ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-buscar="@buscar"
                               asp-route-pagina="@i">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-buscar="@buscar"
                           asp-route-pagina="@(paginaActual + 1)">
                            Siguiente
                        </a>
                    </li>

                </ul>
            }
        </nav>
    </div>

    <!-- VOLVER A PRODUCTOS -->
    <div class="d-flex justify-content-start mt-4">
        <a asp-controller="Productos"
           asp-action="Index"
           class="btn he-btn-volver">
            <i class="fas fa-arrow-left me-2"></i>
            Volver a Productos
        </a>
    </div>

</div>

<!-- SECCIÓN VUE: GESTIÓN REACTIVA DE CATEGORÍAS -->
<div id="pruebaVueCategorias" class="mt-5">

    <hr class="my-4" />

    <h3>{{ mensaje }}</h3>
    <p class="text-muted">
        Gestión de categorías mediante Vue.
    </p>

    <!-- FORMULARIO -->
    <div class="card card-body mb-4">
        <h5>
            {{ idCategoriaEditando === null
            ? 'Nueva categoría'
            : 'Editar categoría' }}
        </h5>

        <form v-on:submit.prevent="guardarCategoria">
            <label for="nombreCategoriaVue" class="form-label">
                Nombre de la categoría
            </label>

            <input id="nombreCategoriaVue"
                   v-model="nombreFormulario"
                   class="form-control mb-3"
                   maxlength="100"
                   required
                   placeholder="Ej.: Amaderada" />

            <div class="d-flex gap-2">
                <button type="submit"
                        class="btn btn-dark"
                        :disabled="guardando">
                    {{ guardando
                    ? 'Guardando...'
                    : (idCategoriaEditando === null
                    ? 'Crear categoría'
                    : 'Guardar cambios') }}
                </button>

                <button v-if="idCategoriaEditando !== null"
                        type="button"
                        class="btn btn-outline-secondary"
                        v-on:click="cancelarEdicion">
                    Cancelar
                </button>
            </div>
        </form>
    </div>

    <!-- MENSAJES -->
    <div v-if="error" class="alert alert-danger">
        {{ error }}
    </div>

    <div v-if="mensajeOperacion" class="alert alert-success">
        {{ mensajeOperacion }}
    </div>

    <p v-if="cargando">Cargando categorías...</p>

    <!-- TABLA REACTIVA -->
    <div v-if="!cargando" class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                <tr v-for="categoria in categorias"
                    :key="categoria.idCategoria">
                    <td>{{ categoria.idCategoria }}</td>
                    <td>{{ categoria.nombre }}</td>

                    <td class="text-end">
                        <button type="button"
                                class="btn btn-sm btn-outline-primary me-1"
                                v-on:click="iniciarEdicion(categoria)">
                            Editar
                        </button>

                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                v-on:click="eliminarCategoria(categoria)">
                            Eliminar
                        </button>
                    </td>
                </tr>

                <tr v-if="categorias.length === 0">
                    <td colspan="3" class="text-center">
                        No hay categorías registradas.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

</div>

@section Scripts {

    <!-- BÚSQUEDA AUTOMÁTICA DE CATEGORÍAS -->
    <script>
        (() => {
            const formulario =
                document.getElementById('formBuscarCategorias');
            const buscador =
                document.getElementById('buscarCategorias');
            const limpiar =
                document.getElementById('limpiarBusquedaCategorias');
            const estado =
                document.getElementById('estadoBusquedaCategorias');
            const tabla =
                document.getElementById('tablaCategorias');
            const contador =
                document.getElementById('contadorCategorias');
            const paginacion =
                document.getElementById('contenedorPaginacionCategorias');

            if (!formulario || !buscador || !limpiar ||
                !estado || !tabla || !contador || !paginacion) {
                return;
            }

            let temporizador;
            let controladorActual = null;

            buscador.addEventListener('input', () => {
                clearTimeout(temporizador);

                limpiar.style.display = buscador.value.trim()
                    ? 'inline-block'
                    : 'none';

                estado.textContent =
                    'Buscando familias olfativas...';

                temporizador = setTimeout(async () => {
                    if (controladorActual) {
                        controladorActual.abort();
                    }

                    const controlador = new AbortController();
                    controladorActual = controlador;

                    const parametros = new URLSearchParams(
                        new FormData(formulario)
                    );

                    parametros.delete('pagina');

                    const url =
                        formulario.action + '?' + parametros.toString();

                    try {
                        const respuesta = await fetch(url, {
                            method: 'GET',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            signal: controlador.signal
                        });

                        if (!respuesta.ok) {
                            throw new Error(
                                'No se pudieron cargar las categorías.'
                            );
                        }

                        const html = await respuesta.text();

                        const documento =
                            new DOMParser().parseFromString(
                                html,
                                'text/html'
                            );

                        const nuevaTabla =
                            documento.getElementById('tablaCategorias');
                        const nuevoContador =
                            documento.getElementById('contadorCategorias');
                        const nuevaPaginacion =
                            documento.getElementById(
                                'contenedorPaginacionCategorias'
                            );

                        if (!nuevaTabla || !nuevoContador ||
                            !nuevaPaginacion) {
                            throw new Error(
                                'La respuesta no contiene los resultados esperados.'
                            );
                        }

                        if (controlador !== controladorActual) {
                            return;
                        }

                        tabla.innerHTML = nuevaTabla.innerHTML;
                        contador.innerHTML = nuevoContador.innerHTML;
                        paginacion.innerHTML =
                            nuevaPaginacion.innerHTML;

                        estado.textContent =
                            'Resultados actualizados.';

                    } catch (error) {
                        if (error.name !== 'AbortError') {
                            console.error(error);
                            estado.textContent =
                                'No se pudo completar la búsqueda. Intentá nuevamente.';
                        }
                    }
                }, 200);
            });

            limpiar.addEventListener('click', event => {
                event.preventDefault();

                buscador.value = '';
                clearTimeout(temporizador);

                if (controladorActual) {
                    controladorActual.abort();
                }

                buscador.dispatchEvent(new Event('input'));
            });

            formulario.addEventListener('submit', event => {
                event.preventDefault();
                clearTimeout(temporizador);
                buscador.dispatchEvent(new Event('input'));
            });
        })();
    </script>

    <!-- VUE 3 -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>

    <!-- CRUD REACTIVO DE CATEGORÍAS -->
    <script>
        (() => {
            const contenedor =
                document.getElementById('pruebaVueCategorias');

            if (!contenedor) return;

            if (typeof Vue === 'undefined') {
                contenedor.textContent =
                    'No se pudo cargar Vue. Verificá tu conexión a Internet.';
                return;
            }

            Vue.createApp({
                data() {
                    return {
                        mensaje: 'Gestión de categorías con Vue',
                        categorias: [],
                        cargando: true,
                        guardando: false,
                        error: '',
                        mensajeOperacion: '',
                        idCategoriaEditando: null,
                        nombreFormulario: ''
                    };
                },

                mounted() {
                    this.cargarCategorias();
                },

                methods: {
                    async cargarCategorias() {
                        this.cargando = true;
                        this.error = '';

                        try {
                            const respuesta =
                                await fetch('/api/categoria');

                            if (!respuesta.ok) {
                                throw new Error(
                                    'No se pudieron cargar las categorías.'
                                );
                            }

                            this.categorias =
                                await respuesta.json();

                        } catch (error) {
                            this.error = error.message;
                        } finally {
                            this.cargando = false;
                        }
                    },

                    iniciarEdicion(categoria) {
                        this.idCategoriaEditando =
                            categoria.idCategoria;
                        this.nombreFormulario = categoria.nombre;
                        this.error = '';
                        this.mensajeOperacion = '';
                    },

                    cancelarEdicion() {
                        this.idCategoriaEditando = null;
                        this.nombreFormulario = '';
                        this.error = '';
                        this.mensajeOperacion = '';
                    },

                    async guardarCategoria() {
                        const nombre =
                            this.nombreFormulario.trim();

                        if (!nombre) {
                            this.error =
                                'Ingresá el nombre de la categoría.';
                            return;
                        }

                        this.guardando = true;
                        this.error = '';
                        this.mensajeOperacion = '';

                        const editando =
                            this.idCategoriaEditando !== null;

                        const url = editando
                            ? `/api/categoria/${this.idCategoriaEditando}`
                            : '/api/categoria';

                        const metodo = editando ? 'PUT' : 'POST';

                        const datos = editando
                            ? {
                                idCategoria: this.idCategoriaEditando,
                                nombre: nombre
                            }
                            : { nombre: nombre };

                        try {
                            const respuesta = await fetch(url, {
                                method: metodo,
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify(datos)
                            });

                            if (!respuesta.ok) {
                                let detalle =
                                    'No se pudo guardar la categoría.';

                                try {
                                    const cuerpo =
                                        await respuesta.json();

                                    if (cuerpo.mensaje) {
                                        detalle = cuerpo.mensaje;
                                    }
                                } catch (_) { }

                                throw new Error(detalle);
                            }

                            this.idCategoriaEditando = null;
                            this.nombreFormulario = '';

                            await this.cargarCategorias();

                            this.mensajeOperacion = editando
                                ? 'Categoría actualizada correctamente.'
                                : 'Categoría creada correctamente.';

                        } catch (error) {
                            this.error = error.message;
                        } finally {
                            this.guardando = false;
                        }
                    },

                    async eliminarCategoria(categoria) {
                        const confirmar = confirm(
                            `¿Querés eliminar la categoría "${categoria.nombre}"?`
                        );

                        if (!confirmar) return;

                        this.error = '';
                        this.mensajeOperacion = '';

                        try {
                            const respuesta = await fetch(
                                `/api/categoria/${categoria.idCategoria}`,
                                { method: 'DELETE' }
                            );

                            if (!respuesta.ok) {
                                let detalle =
                                    'No se pudo eliminar la categoría.';

                                try {
                                    const cuerpo =
                                        await respuesta.json();

                                    if (cuerpo.mensaje) {
                                        detalle = cuerpo.mensaje;
                                    }
                                } catch (_) { }

                                throw new Error(detalle);
                            }

                            if (
                                this.idCategoriaEditando ===
                                categoria.idCategoria
                            ) {
                                this.cancelarEdicion();
                            }

                            await this.cargarCategorias();

                            this.mensajeOperacion =
                                'Categoría eliminada correctamente.';

                        } catch (error) {
                            this.error = error.message;
                        }
                    }
                }
            }).mount('#pruebaVueCategorias');
        })();
    </script>
}