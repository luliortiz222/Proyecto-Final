@model ProyectoIntegradorFinal.Models.Direccion

@{
    ViewData["Title"] = "Eliminar dirección";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-7">
            <span class="text-uppercase small"
                  style="letter-spacing: .15em; color: #96713D;">
                HOME ELIXIR
            </span>

            <h2 class="mt-2">Eliminar dirección</h2>
            <hr />

            <div class="card shadow-sm"
                 style="border-color: #E5D8C5;">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <i class="fas fa-triangle-exclamation fa-3x text-warning"></i>
                        <h4 class="mt-3">
                            ¿Querés eliminar esta dirección?
                        </h4>
                        <p class="text-muted">
                            Esta acción no se puede deshacer.
                        </p>
                    </div>

                    <div class="p-3 mb-4"
                         style="background: #F7F1E8; border: 1px solid #E5D8C5;">
                        <p class="mb-2">
                            <strong>Calle y número:</strong>
                            @Model.Calle @Model.Numero
                        </p>
                        <p class="mb-2">
                            <strong>Ciudad:</strong> @Model.Ciudad
                        </p>
                        <p class="mb-2">
                            <strong>Provincia:</strong> @Model.Provincia
                        </p>
                        <p class="mb-0">
                            <strong>Código postal:</strong>
                            @Model.CodigoPostal
                        </p>
                    </div>

                    <form asp-action="Delete"
                          asp-route-id="@Model.IdDireccion"
                          method="post">
                        @Html.AntiForgeryToken()

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash me-2"></i>
                                Sí, eliminar dirección
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
